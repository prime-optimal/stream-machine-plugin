amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

exclude = List("node_modules", "dist", "artifacts", ".agents", ".claude", "docs/packages")

steps {
  ["secrets"] {
    check = "mise run secrets:check"
  }
  ["markdown"] {
    glob = List("**/*.md")
    check = "mdsmith check {{files}}"
  }
  ["whitespace"] {
    check = "git diff --check --cached && git diff --check"
  }
}

hooks {
  ["pre-commit"] {
    fix = false
    stage = false
    stash = "none"
  }
  ["commit-msg"] {
    steps {
      ["commitizen"] {
        check = "uv run --no-project --with commitizen==4.19.3 cz check --commit-msg-file {{commit_msg_file}}"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["types"] { check = "mise run check" }
      ["tests"] { check = "mise run test" }
    }
  }
}
