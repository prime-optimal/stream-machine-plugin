{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "stream-machine": {
      "type": "streamable-http",
      "url": "https://stream-machine-oauth-test.tinycocoa22.chatgpt.site/mcp",
      "extensions": { "com.openai": { "auth": { "type": "oauth" } } }
    },
    "stream-machine-desktop": {
      "type": "stdio",
      "command": "bun",
      "args": ["${PLUGIN_ROOT}/dist/server.js"],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
