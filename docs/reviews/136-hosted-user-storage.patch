--- /dev/null
+++ b/lib/clips/download.ts
@@ -0,0 +1,39 @@
+import {TwitchFault, type TwitchAccountProvider} from '../stream-machine/auth/twitch';
+import {TwitchClipClient, clipIdSchema} from '../stream-machine/adapters/twitch/clips-client';
+import {UserDataStore} from '../user-data/store';
+import {createHostedClipWriter} from './storage-writer';
+
+type Dependencies = {
+  ownerId: string;
+  accounts: TwitchAccountProvider;
+  client?: Pick<TwitchClipClient, 'read' | 'download'>;
+} & ({
+  db: D1Database;
+  bucket: R2Bucket;
+  origin: string;
+  writer?: never;
+} | {
+  writer: Pick<ReturnType<typeof createHostedClipWriter>, 'write'>;
+  db?: never;
+  bucket?: never;
+  origin?: never;
+});
+export function createHostedClipDownload(options: Dependencies) {
+  if (!options.ownerId) throw new TwitchFault('SIGN_IN_REQUIRED');
+  const client = options.client ?? new TwitchClipClient();
+  const writer = options.writer ?? createHostedClipWriter({
+    ownerId: options.ownerId,
+    store: new UserDataStore({db: options.db, bucket: options.bucket, origin: options.origin}),
+  });
+  return async (clipId: string) => {
+    if (!clipIdSchema.safeParse(clipId).success) throw new TwitchFault('INVALID_CLIP_ID');
+    const {clip,format,url} = await options.accounts.withAccount(async access => {
+      if (!access.account.scopes.includes('channel:manage:clips')) throw new TwitchFault('TWITCH_SCOPE_REQUIRED');
+      const clip = await client.read(access, clipId);
+      if (clip.broadcasterId !== access.account.id) throw new TwitchFault('CLIP_WRONG_BROADCASTER');
+      return {clip,...await client.download(access, clipId)};
+    });
+    const artifact = await writer.write(url);
+    return {mode:'live',clip,format,artifact};
+  };
+}
diff --git a/lib/clips/storage-writer.ts b/lib/clips/storage-writer.ts
new file mode 100644
index 0000000..3ab139d
--- /dev/null
+++ b/lib/clips/storage-writer.ts
@@ -0,0 +1,74 @@
+import {createHash} from 'node:crypto';
+import {TwitchFault} from '../stream-machine/auth/twitch';
+import type {UserDataStore} from '../user-data/store';
+
+type Options = {
+  ownerId: string;
+  store: Pick<UserDataStore, 'write'>;
+  fetcher?: typeof fetch;
+  maxBytes?: number;
+  timeoutMs?: number;
+  createStream?: (length: number) => {readable: ReadableStream<Uint8Array>; writable: WritableStream<Uint8Array>};
+};
+function validateUrl(value: string) {
+  let url: URL;
+  try {url = new URL(value);} catch {throw new TwitchFault('CLIP_DOWNLOAD_URL_REJECTED');}
+  if (url.protocol !== 'https:' || url.hostname !== 'production.assets.clips.twitchcdn.net' ||
+      url.username || url.password || url.port || url.hash) throw new TwitchFault('CLIP_DOWNLOAD_URL_REJECTED');
+}
+export function createHostedClipWriter(options: Options) {
+  if (!options.ownerId) throw new TwitchFault('SIGN_IN_REQUIRED');
+  return {async write(url: string) {
+    validateUrl(url);
+    const controller = new AbortController();
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    const deadline = new Promise<never>((_, reject) => {
+      timer = setTimeout(() => {
+        controller.abort();
+        reject(new TwitchFault('CLIP_DOWNLOAD_TIMEOUT'));
+      }, options.timeoutMs ?? 120000);
+    });
+    let body: ReadableStream<Uint8Array> | null = null;
+    try {
+      const response = await Promise.race([
+        (options.fetcher ?? fetch)(url, {signal: controller.signal, redirect: 'error'}), deadline,
+      ]);
+      body = response.body;
+      if (response.status >= 300 && response.status < 400) throw new TwitchFault('CLIP_DOWNLOAD_REDIRECT_REJECTED');
+      if ([401,403,404,410].includes(response.status)) throw new TwitchFault('CLIP_DOWNLOAD_EXPIRED');
+      if (!response.ok) throw new TwitchFault('CLIP_DOWNLOAD_FAILED');
+      if (!body) throw new TwitchFault('CLIP_DOWNLOAD_EMPTY');
+      const length = response.headers.get('content-length');
+      if (length === null || !/^\d+$/.test(length)) throw new TwitchFault('CLIP_DOWNLOAD_INVALID_RESPONSE');
+      const expected = Number(length);
+      if (!Number.isSafeInteger(expected) || expected > (options.maxBytes ?? 512 * 1024 * 1024)) throw new TwitchFault('CLIP_DOWNLOAD_TOO_LARGE');
+      if (expected <= 0) throw new TwitchFault('CLIP_DOWNLOAD_EMPTY');
+      const stream = options.createStream?.(expected) ?? new FixedLengthStream(expected);
+      const hash = createHash('sha256');
+      let bytes = 0;
+      const measured = new TransformStream<Uint8Array, Uint8Array>({
+        transform(chunk, output) {
+          bytes += chunk.byteLength;
+          if (bytes > expected) throw new TwitchFault('CLIP_DOWNLOAD_INVALID_RESPONSE');
+          hash.update(chunk);
+          output.enqueue(chunk);
+        },
+        flush() {if (bytes !== expected) throw new TwitchFault('CLIP_DOWNLOAD_INVALID_RESPONSE');},
+      });
+      const completion = body.pipeThrough(measured).pipeTo(stream.writable, {signal: controller.signal})
+        .then(() => ({bytes, sha256: hash.digest('hex')}));
+      void completion.catch(() => {});
+      const stored = options.store.write({ownerId: options.ownerId, kind: 'clips', body: stream.readable, completion});
+      const [artifact] = await Promise.race([Promise.all([stored, completion]), deadline]);
+      return artifact;
+    } catch (error) {
+      if (controller.signal.aborted) throw new TwitchFault('CLIP_DOWNLOAD_TIMEOUT');
+      if (error instanceof TwitchFault) throw error;
+      throw new TwitchFault('CLIP_DOWNLOAD_FAILED');
+    } finally {
+      clearTimeout(timer);
+      controller.abort();
+      if (body && !body.locked) void body.cancel().catch(() => {});
+    }
+  }};
+}
diff --git a/lib/user-data/store.ts b/lib/user-data/store.ts
new file mode 100644
index 0000000..71d3d6d
--- /dev/null
+++ b/lib/user-data/store.ts
@@ -0,0 +1,58 @@
+import {z} from 'zod';
+
+const uuid=z.string().uuid();
+const kind=z.string().regex(/^[a-z][a-z0-9-]{0,31}$/);
+const completionSchema=z.object({bytes:z.number().int().positive().max(512*1024*1024),sha256:z.string().regex(/^[a-f0-9]{64}$/)});
+const folderSchema=z.object({folder_id:uuid});
+const artifactSchema=z.object({object_key:z.string(),bytes:z.number().int().positive(),media_type:z.string(),filename:z.string()});
+const privateHeaders={'Cache-Control':'private, no-store','Referrer-Policy':'no-referrer','X-Content-Type-Options':'nosniff'};
+export type HostedArtifact={storage:'hosted';id:string;url:string;bytes:number;sha256:string;completedAt:string};
+type Options={db:Pick<D1Database,'prepare'>;bucket:Pick<R2Bucket,'put'|'get'|'delete'>;origin:string};
+type WriteInput={ownerId:string;kind:string;body:ReadableStream<Uint8Array>;completion:Promise<z.infer<typeof completionSchema>>};
+
+export class UserDataStore {
+ private db:Options['db'];
+ private bucket:Options['bucket'];
+ private origin:string;
+ constructor({db,bucket,origin}:Options) {
+  const url=new URL(origin);
+  if(url.origin!==origin||url.username||url.password||!(url.protocol==='https:'||(url.protocol==='http:'&&['localhost','127.0.0.1'].includes(url.hostname))))throw Error('Invalid storage origin');
+  this.db=db;this.bucket=bucket;this.origin=url.origin;
+ }
+ async folder(ownerId:string) {
+  z.string().min(1).parse(ownerId);
+  await this.db.prepare('INSERT INTO user_data_folders (owner_id, folder_id, created_at) VALUES (?, ?, ?) ON CONFLICT(owner_id) DO NOTHING').bind(ownerId,crypto.randomUUID(),Date.now()).run();
+  const folder=folderSchema.parse(await this.db.prepare('SELECT folder_id FROM user_data_folders WHERE owner_id = ?').bind(ownerId).first());
+  return folder.folder_id;
+ }
+ async write({ownerId,kind:dataKind,body,completion}:WriteInput):Promise<HostedArtifact> {
+  const completed=completion.then(value=>({ok:true,value} as const),error=>({ok:false,error} as const));
+  z.string().min(1).parse(ownerId);kind.parse(dataKind);
+  const folder=await this.folder(ownerId),id=crypto.randomUUID();
+  const filename=id+'.mp4',objectKey=folder+'/'+dataKind+'/'+filename;
+  try {
+   const object=await this.bucket.put(objectKey,body,{httpMetadata:{contentType:'video/mp4',cacheControl:'private, no-store'}});
+   const outcome=await completed;
+   if(!outcome.ok)throw outcome.error;
+   const metadata=completionSchema.parse(outcome.value);
+   if(!object||object.size!==metadata.bytes)throw Error('Stored file length mismatch');
+   const completedAt=new Date().toISOString();
+   await this.db.prepare('INSERT INTO user_data_artifacts (id, owner_id, object_key, kind, media_type, filename, bytes, sha256, completed_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)').bind(id,ownerId,objectKey,dataKind,'video/mp4',filename,metadata.bytes,metadata.sha256,completedAt).run();
+   return {storage:'hosted',id,url:this.origin+'/api/user-data/files/'+id,...metadata,completedAt};
+  } catch(error) {
+   try {await this.bucket.delete(objectKey);}catch{}
+   throw error;
+  }
+ }
+ async read({ownerId,id}:{ownerId:string|null|undefined;id:string}):Promise<Response> {
+  if(!ownerId)return Response.json({error:'sign_in_required'},{status:401,headers:privateHeaders});
+  const missing=()=>Response.json({error:'file_not_found'},{status:404,headers:privateHeaders});
+  if(!uuid.safeParse(id).success)return missing();
+  const row=await this.db.prepare('SELECT object_key, bytes, media_type, filename FROM user_data_artifacts WHERE id = ? AND owner_id = ?').bind(id,ownerId).first();
+  if(!row)return missing();
+  const artifact=artifactSchema.parse(row);
+  const object=await this.bucket.get(artifact.object_key);
+  if(!object)return missing();
+  return new Response(object.body,{headers:{...privateHeaders,'Content-Type':artifact.media_type,'Content-Length':String(artifact.bytes),'Content-Disposition':'attachment; filename="'+artifact.filename+'"'}});
+ }
+}
