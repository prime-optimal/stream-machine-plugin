+import {env} from 'cloudflare:workers';
+import {accountUser,signedOutResponse} from '@/lib/twitch/runtime';
+import {UserDataStore} from '@/lib/user-data/store';
+
+export async function GET(request:Request,{params}:{params:Promise<{id:string}>}) {
+ const user=await accountUser();
+ if(!user)return signedOutResponse();
+ if(!env.DB||!env.BUCKET)return Response.json({error:'storage_unavailable'},{status:503,headers:{'Cache-Control':'private, no-store'}});
+ try {
+  const {id}=await params;
+  return await new UserDataStore({db:env.DB,bucket:env.BUCKET,origin:new URL(request.url).origin}).read({ownerId:user.userId,id});
+ } catch {
+  return Response.json({error:'storage_unavailable'},{status:503,headers:{'Cache-Control':'private, no-store'}});
+ }
+}
