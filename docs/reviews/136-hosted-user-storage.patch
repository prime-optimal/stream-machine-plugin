+import {expect,test} from 'bun:test';
+import {createHostedClipDownload} from '../../lib/clips/download.ts';
+const clipId='Clip_fixture';
+const access={account:{id:'broadcaster',login:'creator',displayName:'Creator',scopes:['channel:manage:clips']},clientId:'fixture-client',accessToken:'fixture-token'};
+function fixture(options={}) {
+ const calls=[];const accounts={async withAccount(operation){return operation(options.access??access);}};
+ const client={async read(){calls.push('read');return {id:clipId,broadcasterId:options.broadcasterId??'broadcaster'};},async download(){calls.push('download');return {format:'landscape',url:'https://production.assets.clips.twitchcdn.net/clip.mp4'};}};
+ const writer={async write(){calls.push('write');return {storage:'hosted',id:'uuid',url:'https://studio.example/api/user-data/files/uuid',bytes:4,sha256:'hash',completedAt:'now'};}};
+ return {download:createHostedClipDownload({ownerId:'sites-user',accounts,client,writer}),calls};
+}
+test('hosted default returns private artifact link without local path',async()=>{
+ const {download,calls}=fixture();const result=await download(clipId);
+ expect(result.mode).toBe('live');expect(result.artifact.storage).toBe('hosted');expect(result.artifact).not.toHaveProperty('path');expect(calls).toEqual(['read','download','write']);
+});
+test('rejects wrong broadcaster before acquiring source or storing',async()=>{
+ const {download,calls}=fixture({broadcasterId:'other'});
+ await expect(download(clipId)).rejects.toThrow('CLIP_WRONG_BROADCASTER');expect(calls).toEqual(['read']);
+});
+test('rejects missing scope before Twitch request',async()=>{
+ const {download,calls}=fixture({access:{...access,account:{...access.account,scopes:[]}}});
+ await expect(download(clipId)).rejects.toThrow('TWITCH_SCOPE_REQUIRED');expect(calls).toEqual([]);
+});
+test('rejects invalid ID before account or writer',async()=>{
+ const {download,calls}=fixture();await expect(download('../bad')).rejects.toThrow('INVALID_CLIP_ID');expect(calls).toEqual([]);
+});
+test('rejects unsigned owner before creating runtime',()=>{
+ expect(()=>createHostedClipDownload({ownerId:'',accounts:{}})).toThrow('SIGN_IN_REQUIRED');
+});
