+import {env} from 'cloudflare:workers';
+import {handleMcp,sitesPrincipal} from '@/lib/mcp/handler';
+import {hostedRuntime} from '@/lib/mcp/runtime';
+import {configuration,service} from '@/lib/twitch/runtime';
+
+export async function POST(request:Request) {
+  if(!sitesPrincipal(request))return handleMcp(request,()=>{throw new Error("sign_in_required");});
+  const setup=await configuration(request);
+  return handleMcp(request,ownerId=>{
+    return hostedRuntime({ownerId,oauth:service,db:env.DB,bucket:env.BUCKET,setup});
+  });
+}
+export function GET(request:Request){return handleMcp(request,()=>{throw new Error('method_not_allowed');});}
+export const DELETE=GET;
