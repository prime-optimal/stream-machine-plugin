diff --git a/components/channel-status.tsx b/components/channel-status.tsx
new file mode 100644
index 0000000..7c379c3
--- /dev/null
+++ b/components/channel-status.tsx
@@ -0,0 +1,32 @@
+'use client';
+import {useState} from 'react';
+import {z} from 'zod';
+
+const replySchema=z.object({result:z.object({isError:z.boolean().optional(),structuredContent:z.object({
+  twitch:z.object({channel:z.object({login:z.string(),title:z.string(),categoryName:z.string()})}).optional(),
+}).optional()}).optional()});
+type State={kind:'idle'}|{kind:'loading'}|{kind:'failed'}|{kind:'loaded';login:string;title:string;categoryName:string};
+
+export function ChannelStatus() {
+  const [state,setState]=useState<State>({kind:'idle'});
+  async function read() {
+    setState({kind:'loading'});
+    try {
+      const response=await fetch('/api/twitch/channel',{method:'POST'});
+      if(!response.ok)throw new Error('unavailable');
+      const reply=replySchema.parse(await response.json());
+      const channel=reply.result?.structuredContent?.twitch?.channel;
+      if(reply.result?.isError||!channel)throw new Error('unavailable');
+      setState({kind:'loaded',...channel});
+    }catch{setState({kind:'failed'});}
+  }
+  return <section aria-label="Your Twitch channel" className="connection-controls">
+    <h2>Your channel</h2>
+    <p>Read your current Twitch title and category through the hosted connection.</p>
+    <button className="secondary" disabled={state.kind==='loading'} onClick={()=>void read()}>{state.kind==='loading'?'Reading channel…':'Read my channel'}</button>
+    <div aria-live="polite">
+      {state.kind==='loaded'&&<><p>Channel: <strong>@{state.login}</strong></p><p>Title: {state.title}</p><p>Category: {state.categoryName||'Not set'}</p></>}
+      {state.kind==='failed'&&<p>Channel unavailable. Check your Twitch connection and try again.</p>}
+    </div>
+  </section>;
+}
