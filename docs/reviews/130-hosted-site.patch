--- /dev/null
+++ b/app/twitch/approve/page.tsx
@@ -0,0 +1,32 @@
+import {env} from 'cloudflare:workers';
+import {notFound} from 'next/navigation';
+import {z} from 'zod';
+import {requireChatGPTUser} from '@/app/chatgpt-auth';
+import {D1TitlePreviewStore} from '@/lib/mcp/title-preview-store';
+export const dynamic='force-dynamic';
+
+export default async function Approval({searchParams}:{searchParams:Promise<{id?:string}>}) {
+  const query=await searchParams;
+  const parsed=z.string().uuid().safeParse(query.id);
+  if(!parsed.success)notFound();
+  const user=await requireChatGPTUser(`/twitch/approve?id=${encodeURIComponent(parsed.data)}`);
+  if(!env.DB)notFound();
+  const preview=await new D1TitlePreviewStore(env.DB,user.userId).get(parsed.data);
+  if(!preview||preview.consumed||preview.expiresAt<=Date.now())notFound();
+  return <main className="connection-shell">
+    <header><span className="brand-mark" aria-hidden="true">S</span><span>STREAM MACHINE</span></header>
+    <section className="connection-card">
+      <p className="eyebrow">REVIEW YOUR CHANNEL UPDATE</p>
+      <h1>Approve this<br/>Twitch title.</h1>
+      <p>Account: <strong>@{preview.before.login}</strong></p>
+      <h2>Current title</h2><p>{preview.before.title}</p>
+      <h2>New title</h2><p>{preview.title}</p>
+      <p>Expires {new Date(preview.expiresAt).toISOString()}.</p>
+      {preview.approved?<p role="status">Approved. Return to your chat and apply this preview.</p>:<form method="post" action="/api/twitch/approve">
+        <input type="hidden" name="previewId" value={parsed.data}/>
+        <button className="primary" type="submit">Approve exact title</button>
+      </form>}
+      <footer>Approval permits this exact preview. Your title changes only when you ask Stream Machine to apply it. <a href="/">Back to connection</a></footer>
+    </section>
+  </main>;
+}
