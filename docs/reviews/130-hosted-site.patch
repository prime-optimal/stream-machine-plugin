--- /dev/null
+++ b/app/api/twitch/approve/route.ts
@@ -0,0 +1,20 @@
+import {env} from 'cloudflare:workers';
+import {z} from 'zod';
+import {accountUser,configuration,errorResponse,responseHeaders,signedOutResponse} from '@/lib/twitch/runtime';
+import {requireSameOrigin} from '@/lib/twitch/http';
+import {D1TitlePreviewStore} from '@/lib/mcp/title-preview-store';
+
+export async function POST(request:Request) {
+  const user=await accountUser();if(!user)return signedOutResponse();
+  const setup=await configuration(request);
+  if(!setup.ready||!env.DB)return Response.json({error:'setup_incomplete'},{status:503,headers:responseHeaders});
+  try {
+    requireSameOrigin(request,setup.redirectUri);
+    const form=await request.formData();
+    const input=z.object({previewId:z.string().uuid()}).strict().safeParse(Object.fromEntries(form));
+    if(!input.success)return Response.json({error:'invalid_input'},{status:400,headers:responseHeaders});
+    const approved=await new D1TitlePreviewStore(env.DB,user.userId).approve(input.data.previewId,Date.now());
+    if(!approved)return Response.json({error:'preview_not_found'},{status:404,headers:responseHeaders});
+    return new Response(null,{status:303,headers:{...responseHeaders,Location:`/twitch/approve?id=${encodeURIComponent(input.data.previewId)}`}});
+  }catch(error){return errorResponse(error);}
+}
diff --git a/app/api/twitch/channel/route.ts b/app/api/twitch/channel/route.ts
