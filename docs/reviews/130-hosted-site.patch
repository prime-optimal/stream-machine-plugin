+import {expect,test} from 'bun:test';
+import {Miniflare} from 'miniflare';
+import {mkdtemp,readFile,readdir,rm} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+
+test('real Worker streams into R2 and D1 enforces owner-only reads',async()=>{
+ const directory=await mkdtemp(join(tmpdir(),'clip-worker-136-'));
+ let mf;
+ try{
+  const built=await Bun.build({entrypoints:[new URL('./worker-fixture.ts',import.meta.url).pathname],outdir:directory,target:'node',format:'esm',external:['node:crypto']});
+  if(!built.success)throw new AggregateError(built.logs,'Worker fixture build failed');
+  mf=new Miniflare({modules:true,modulesRoot:directory,scriptPath:built.outputs[0].path,compatibilityDate:'2026-05-15',compatibilityFlags:['nodejs_compat'],d1Databases:['DB'],r2Buckets:['BUCKET']});
+  const db=await mf.getD1Database('DB');
+  const migrations=new URL('../../drizzle/',import.meta.url);
+  for(const name of (await readdir(migrations)).filter(n=>n.endsWith('.sql')).sort()){
+   for(const sql of (await readFile(new URL(name,migrations),'utf8')).split('--> statement-breakpoint').filter(s=>s.trim()))await db.prepare(sql).run();
+  }
+  const upload=await mf.dispatchFetch('https://studio.example/upload',{method:'POST',headers:{'fixture-user':'alice'}});
+  if(!upload.ok)throw Error(await upload.text());expect(upload.status).toBe(200);const artifact=await upload.json();expect(artifact.bytes).toBe(4);expect(artifact.storage).toBe('hosted');
+  const own=await mf.dispatchFetch(artifact.url,{headers:{'fixture-user':'alice'}});
+  expect(own.status).toBe(200);expect(await own.text()).toBe('clip');expect(own.headers.get('cache-control')).toBe('private, no-store');
+  const foreign=await mf.dispatchFetch(artifact.url,{headers:{'fixture-user':'bob'}});
+  expect(foreign.status).toBe(404);
+  const anonymous=await mf.dispatchFetch(artifact.url);expect(anonymous.status).toBe(401);
+  const folders=await db.prepare('SELECT folder_id FROM user_data_folders').all();expect(folders.results).toHaveLength(1);
+  const bucket=await mf.getR2Bucket('BUCKET');const objects=await bucket.list();expect(objects.objects[0].key).toBe(folders.results[0].folder_id+'/clips/'+artifact.id+'.mp4');
+ } finally {await mf?.dispose();await rm(directory,{recursive:true,force:true});}
+},30000);
