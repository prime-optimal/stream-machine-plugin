diff --git a/tests/twitch/mcp-access.test.mjs b/tests/twitch/mcp-access.test.mjs
new file mode 100644
index 0000000..3f84a37
--- /dev/null
+++ b/tests/twitch/mcp-access.test.mjs
@@ -0,0 +1,56 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {TwitchService} from '../../lib/twitch/service.ts';
+import {encryptTokens} from '../../lib/twitch/crypto.ts';
+import {fixture} from './helpers.mjs';
+
+async function connect(f, owner) {
+  const service = new TwitchService(f.store, f.client);
+  const start = await service.begin(owner);
+  await service.complete(owner, start.state, start.state, 'code', null);
+  return service;
+}
+
+test('MCP access selects only the authenticated owner and never exposes tokens in status', async () => {
+  const f = fixture();
+  const service = await connect(f, 'alice');
+  let called = false;
+  await assert.rejects(service.withAccessToken('bob', async () => {called = true;}), {code: 'not_connected'});
+  assert.equal(called, false);
+  const publicAccount = await service.withAccessToken('alice', async access => {
+    assert.equal(access.accessToken, 'test-access');
+    assert.equal(access.account.id, 'twitch-user');
+    return {id: access.account.id};
+  });
+  assert.deepEqual(publicAccount, {id: 'twitch-user'});
+  assert.equal(JSON.stringify(await service.status('alice')).includes('test-access'), false);
+  f.sql.close();
+});
+
+test('MCP access uses the refreshed token and does not invoke an operation after disconnect', async () => {
+  const f = fixture();
+  const service = await connect(f, 'alice');
+  f.client.invalidAccess = true;
+  const result = await service.withAccessToken('alice', async access => access.accessToken === 'new-access');
+  assert.equal(result, true);
+  assert.equal(f.client.refreshes, 1);
+  await service.disconnect('alice');
+  await assert.rejects(service.withAccessToken('alice', async () => assert.fail('Disconnected access')), {code: 'not_connected'});
+  f.sql.close();
+});
+
+test('overlapping owners keep separate access tokens', async () => {
+  const f = fixture();
+  const service = await connect(f, 'alice');
+  await connect(f, 'bob');
+  const ciphertext = await encryptTokens({accessToken:'bob-private',refreshToken:'bob-refresh',expiresIn:3600,scopes:f.client.scopes},f.client.config.encryptionSecret,'bob');
+  f.sql.prepare('UPDATE twitch_connections SET token_ciphertext=? WHERE owner_id=?').run(ciphertext,'bob');
+  let release;
+  const waiting = new Promise(resolve => {release = resolve;});
+  const alice = service.withAccessToken('alice', async access => {await waiting;return access.accessToken;});
+  const bob = await service.withAccessToken('bob', async access => access.accessToken);
+  release();
+  assert.equal(bob, 'bob-private');
+  assert.equal(await alice, 'test-access');
+  f.sql.close();
+});
diff --git a/tests/twitch/mcp-handler.test.mjs b/tests/twitch/mcp-handler.test.mjs
new file mode 100644
