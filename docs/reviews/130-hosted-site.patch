+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {D1TitlePreviewStore} from '../../lib/mcp/title-preview-store.ts';
+import {TwitchService} from '../../lib/twitch/service.ts';
+import {fixture} from './helpers.mjs';
+
+async function connectedFixture(){const f=fixture();const service=new TwitchService(f.store,f.client);for(const owner of ['alice','bob']){const start=await service.begin(owner);await service.complete(owner,start.state,start.state,'code',null);}return {...f,service};}
+function preview() {return {id:crypto.randomUUID(),before:{broadcasterId:'twitch-user',login:'creator',displayName:'Creator',title:'Before',categoryId:'1',categoryName:'Category'},title:'After',expiresAt:10000,approved:false,consumed:false};}
+
+test('previews are owner-bound and survive a new request instance',async()=>{
+ const f=await connectedFixture(),a=new D1TitlePreviewStore(f.d1,'alice'),b=new D1TitlePreviewStore(f.d1,'bob');
+ const p=preview();await a.create(p,1000);
+ assert.equal(await b.get(p.id),undefined);
+ assert.equal(await b.approve(p.id,1000),false);
+ assert.equal(await b.consume(p.id,1000),false);
+ const next=new D1TitlePreviewStore(f.d1,'alice');
+ assert.equal((await next.get(p.id)).title,'After');
+ assert.equal(await next.approve(p.id,1000),true);
+ assert.equal(await next.consume(p.id,1000),true);
+ assert.equal(await a.consume(p.id,1000),false);
+ f.sql.close();
+});
+
+test('unapproved and expired previews cannot be consumed; execution lease is shared per owner',async()=>{
+ const f=await connectedFixture(),a=new D1TitlePreviewStore(f.d1,'alice'),next=new D1TitlePreviewStore(f.d1,'alice'),b=new D1TitlePreviewStore(f.d1,'bob');
+ const p=preview();await a.create(p,1000);
+ assert.equal(await a.consume(p.id,1000),false);
+ assert.equal(await a.approve(p.id,10001),false);
+ assert.equal(await a.acquire('first',1000),true);
+ assert.equal(await next.acquire('second',1000),false);
+ assert.equal(await b.acquire('bob-lease',1000),true);
+ await next.release('wrong-lease');
+ assert.equal(await next.acquire('second',1000),false);
+ await a.release('first');
+ assert.equal(await next.acquire('second',1000),true);
+ f.sql.close();
+});
+
+test('preview cap applies per owner and expired previews are pruned',async()=>{
+ const f=await connectedFixture(),a=new D1TitlePreviewStore(f.d1,'alice'),b=new D1TitlePreviewStore(f.d1,'bob');
+ for(let n=0;n<100;n++)await a.create(preview(),1000);
+ await assert.rejects(a.create(preview(),1000),{code:'PREVIEW_LIMIT'});
+ await b.create(preview(),1000);
+ await a.create({...preview(),expiresAt:30000},10001);
+ assert.equal(f.sql.prepare('SELECT COUNT(*) AS n FROM twitch_title_previews WHERE owner_id=?').get('alice').n,1);
+ f.sql.close();
+});
