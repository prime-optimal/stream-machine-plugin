diff --git a/lib/clips/download.ts b/lib/clips/download.ts
new file mode 100644
index 0000000..5da1db0
--- /dev/null
+++ b/lib/clips/download.ts
@@ -0,0 +1,39 @@
+import {TwitchFault, type TwitchAccountProvider} from '../stream-machine/auth/twitch';
+import {TwitchClipClient, clipIdSchema} from '../stream-machine/adapters/twitch/clips-client';
+import {UserDataStore} from '../user-data/store';
+import {createHostedClipWriter} from './storage-writer';
+
+type Dependencies = {
+  ownerId: string;
+  accounts: TwitchAccountProvider;
+  client?: Pick<TwitchClipClient, 'read' | 'download'>;
+} & ({
+  db: D1Database;
+  bucket: R2Bucket;
+  origin: string;
+  writer?: never;
+} | {
+  writer: Pick<ReturnType<typeof createHostedClipWriter>, 'write'>;
+  db?: never;
+  bucket?: never;
+  origin?: never;
+});
+export function createHostedClipDownload(options: Dependencies) {
+  if (!options.ownerId) throw new TwitchFault('SIGN_IN_REQUIRED');
+  const client = options.client ?? new TwitchClipClient();
+  const writer = options.writer ?? createHostedClipWriter({
+    ownerId: options.ownerId,
+    store: new UserDataStore({db: options.db, bucket: options.bucket, origin: options.origin}),
+  });
+  return async (clipId: string) => {
+    if (!clipIdSchema.safeParse(clipId).success) throw new TwitchFault('INVALID_CLIP_ID');
+    const {clip,format,url} = await options.accounts.withAccount(async access => {
+      if (!access.account.scopes.includes('channel:manage:clips')) throw new TwitchFault('TWITCH_SCOPE_REQUIRED');
+      const clip = await client.read(access, clipId);
+      if (clip.broadcasterId !== access.account.id) throw new TwitchFault('CLIP_WRONG_BROADCASTER');
+      return {clip,...await client.download(access, clipId)};
+    });
+    const artifact = await writer.write(url);
+    return {mode:'live',clip,format,artifact};
+  };
+}
diff --git a/lib/clips/storage-writer.ts b/lib/clips/storage-writer.ts
new file mode 100644
index 0000000..3ab139d
--- /dev/null
+++ b/lib/clips/storage-writer.ts
@@ -0,0 +1,74 @@
+import {createHash} from 'node:crypto';
+import {TwitchFault} from '../stream-machine/auth/twitch';
+import type {UserDataStore} from '../user-data/store';
+
+type Options = {
+  ownerId: string;
+  store: Pick<UserDataStore, 'write'>;
+  fetcher?: typeof fetch;
+  maxBytes?: number;
+  timeoutMs?: number;
+  createStream?: (length: number) => {readable: ReadableStream<Uint8Array>; writable: WritableStream<Uint8Array>};
+};
+function validateUrl(value: string) {
+  let url: URL;
+  try {url = new URL(value);} catch {throw new TwitchFault('CLIP_DOWNLOAD_URL_REJECTED');}
+  if (url.protocol !== 'https:' || url.hostname !== 'production.assets.clips.twitchcdn.net' ||
+      url.username || url.password || url.port || url.hash) throw new TwitchFault('CLIP_DOWNLOAD_URL_REJECTED');
+}
+export function createHostedClipWriter(options: Options) {
+  if (!options.ownerId) throw new TwitchFault('SIGN_IN_REQUIRED');
+  return {async write(url: string) {
+    validateUrl(url);
+    const controller = new AbortController();
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    const deadline = new Promise<never>((_, reject) => {
+      timer = setTimeout(() => {
+        controller.abort();
+        reject(new TwitchFault('CLIP_DOWNLOAD_TIMEOUT'));
+      }, options.timeoutMs ?? 120000);
+    });
+    let body: ReadableStream<Uint8Array> | null = null;
+    try {
+      const response = await Promise.race([
+        (options.fetcher ?? fetch)(url, {signal: controller.signal, redirect: 'error'}), deadline,
+      ]);
+      body = response.body;
+      if (response.status >= 300 && response.status < 400) throw new TwitchFault('CLIP_DOWNLOAD_REDIRECT_REJECTED');
+      if ([401,403,404,410].includes(response.status)) throw new TwitchFault('CLIP_DOWNLOAD_EXPIRED');
+      if (!response.ok) throw new TwitchFault('CLIP_DOWNLOAD_FAILED');
+      if (!body) throw new TwitchFault('CLIP_DOWNLOAD_EMPTY');
+      const length = response.headers.get('content-length');
+      if (length === null || !/^\d+$/.test(length)) throw new TwitchFault('CLIP_DOWNLOAD_INVALID_RESPONSE');
+      const expected = Number(length);
+      if (!Number.isSafeInteger(expected) || expected > (options.maxBytes ?? 512 * 1024 * 1024)) throw new TwitchFault('CLIP_DOWNLOAD_TOO_LARGE');
+      if (expected <= 0) throw new TwitchFault('CLIP_DOWNLOAD_EMPTY');
+      const stream = options.createStream?.(expected) ?? new FixedLengthStream(expected);
+      const hash = createHash('sha256');
+      let bytes = 0;
+      const measured = new TransformStream<Uint8Array, Uint8Array>({
+        transform(chunk, output) {
+          bytes += chunk.byteLength;
+          if (bytes > expected) throw new TwitchFault('CLIP_DOWNLOAD_INVALID_RESPONSE');
+          hash.update(chunk);
+          output.enqueue(chunk);
+        },
+        flush() {if (bytes !== expected) throw new TwitchFault('CLIP_DOWNLOAD_INVALID_RESPONSE');},
+      });
+      const completion = body.pipeThrough(measured).pipeTo(stream.writable, {signal: controller.signal})
+        .then(() => ({bytes, sha256: hash.digest('hex')}));
+      void completion.catch(() => {});
+      const stored = options.store.write({ownerId: options.ownerId, kind: 'clips', body: stream.readable, completion});
+      const [artifact] = await Promise.race([Promise.all([stored, completion]), deadline]);
+      return artifact;
+    } catch (error) {
+      if (controller.signal.aborted) throw new TwitchFault('CLIP_DOWNLOAD_TIMEOUT');
+      if (error instanceof TwitchFault) throw error;
+      throw new TwitchFault('CLIP_DOWNLOAD_FAILED');
+    } finally {
+      clearTimeout(timer);
+      controller.abort();
+      if (body && !body.locked) void body.cancel().catch(() => {});
+    }
+  }};
+}
diff --git a/lib/mcp/handler.ts b/lib/mcp/handler.ts
new file mode 100644
index 0000000..985fc95
--- /dev/null
+++ b/lib/mcp/handler.ts
@@ -0,0 +1,75 @@
+import {z} from 'zod';
+import {createTwitchToolDefinitions} from '../stream-machine/adapters/twitch/tool-register';
+import type {TwitchToolRuntime} from '../stream-machine/adapters/twitch/tool-runtime';
+
+const envelope=z.object({jsonrpc:z.literal('2.0'),id:z.union([z.string(),z.number(),z.null()]).optional(),method:z.string(),params:z.unknown().optional()}).strict();
+const callParams=z.object({name:z.string(),arguments:z.record(z.string(),z.unknown()).default({}),_meta:z.record(z.string(),z.unknown()).optional()}).strict();
+const supportedVersions=['2026-07-28','2025-11-25','2025-06-18','2025-03-26'];
+const headers={'Cache-Control':'no-store','Referrer-Policy':'no-referrer'};
+const emptyParams=z.object({}).strict();
+const initializeParams=z.object({protocolVersion:z.string(),capabilities:z.record(z.string(),z.unknown()),clientInfo:z.object({name:z.string(),version:z.string(),title:z.string().optional()}).strict()}).strict();
+const principalSchema=z.string().min(1).max(256).refine(value=>value===value.trim()&&!/[\s,]/.test(value));
+
+export function sitesPrincipal(request:Request):string|null {
+  const parsed=principalSchema.safeParse(request.headers.get('oai-authenticated-user-id'));
+  return parsed.success?parsed.data:null;
+}
+
+export async function handleMcp(request:Request,createRuntime:(ownerId:string)=>TwitchToolRuntime):Promise<Response> {
+  const ownerId=sitesPrincipal(request);
+  if(!ownerId)return Response.json({error:'sign_in_required'},{status:401,headers});
+  const origin=request.headers.get('origin');
+  if(origin&&origin!==new URL(request.url).origin)return Response.json({error:'invalid_origin'},{status:403,headers});
+  if(request.method!=='POST')return Response.json({error:'method_not_allowed'},{status:405,headers:{...headers,Allow:'POST'}});
+  if(request.headers.get('content-type')?.split(';')[0]?.trim().toLowerCase()!=='application/json')return Response.json({error:'json_required'},{status:415,headers});
+  if(new URL(request.url).search)return Response.json({error:'invalid_parameters'},{status:400,headers});
+  const error=(id:string|number|null,code:number,message:string,status=200)=>Response.json({jsonrpc:'2.0',id,error:{code,message}},{status,headers});
+  let value:unknown;
+  try {
+    const body=await request.text();
+    if(body.length>65536)return error(null,-32600,'Request too large',413);
+    value=JSON.parse(body);
+  }catch{return error(null,-32700,'Parse error',400);}
+  const parsed=envelope.safeParse(value);
+  if(!parsed.success)return error(null,-32600,'Invalid Request',400);
+  const message=parsed.data,id=message.id??null;
+  let resolved:TwitchToolRuntime|undefined;
+  const tools=createTwitchToolDefinitions(()=>{resolved??=createRuntime(ownerId);return resolved;});
+  let result:object;
+  switch(message.method) {
+    case 'server/discover':
+      if(!emptyParams.safeParse(message.params??{}).success)return error(id,-32602,'Invalid params');
+      result={supportedVersions,capabilities:{tools:{}},serverInfo:{name:'stream-machine',version:'0.5.0'}};
+      break;
+    case 'initialize': {
+      const initialized=initializeParams.safeParse(message.params);
+      if(!initialized.success)return error(id,-32602,'Invalid params');
+      const protocolVersion=supportedVersions.includes(initialized.data.protocolVersion)?initialized.data.protocolVersion:supportedVersions[0];
+      result={protocolVersion,capabilities:{tools:{}},serverInfo:{name:'stream-machine',version:'0.5.0'}};
+      break;
+    }
+    case 'ping':
+      if(!emptyParams.safeParse(message.params??{}).success)return error(id,-32602,'Invalid params');
+      result={};break;
+    case 'notifications/initialized':
+      if(!emptyParams.safeParse(message.params??{}).success)return error(id,-32602,'Invalid params');
+      return new Response(null,{status:202,headers});
+    case 'tools/list':
+      if(!emptyParams.safeParse(message.params??{}).success)return error(id,-32602,'Invalid params');
+      result={tools:tools.map(tool=>({name:tool.name,description:tool.description,inputSchema:z.toJSONSchema(tool.schema),annotations:tool.annotations}))};
+      break;
+    case 'tools/call': {
+      const args=callParams.safeParse(message.params);
+      if(!args.success)return error(id,-32602,'Invalid params');
+      const tool=tools.find(entry=>entry.name===args.data.name);
+      if(!tool)return error(id,-32602,'Unknown tool');
+      if(message.id===undefined)return error(null,-32600,'Tool calls require an id',400);
+      if(request.signal.aborted)return error(id,-32603,'Request cancelled');
+      try {result=await tool.execute(args.data.arguments);}catch{return error(id,-32603,'Tool unavailable');}
+      break;
+    }
+    default:return error(id,-32601,'Method not found');
+  }
+  if(message.id===undefined)return new Response(null,{status:202,headers});
+  return Response.json({jsonrpc:'2.0',id,result},{headers});
+}
diff --git a/lib/mcp/runtime.ts b/lib/mcp/runtime.ts
new file mode 100644
index 0000000..71eb52f
--- /dev/null
+++ b/lib/mcp/runtime.ts
@@ -0,0 +1,44 @@
+import {TwitchFault,type TwitchAccountProvider} from '../stream-machine/auth/twitch';
+import {TwitchTitleService} from '../stream-machine/adapters/twitch/service';
+import {TwitchChannelClient} from '../stream-machine/adapters/twitch/client';
+import {TwitchClipClient} from '../stream-machine/adapters/twitch/clips-client';
+import type {TwitchToolRuntime} from '../stream-machine/adapters/twitch/tool-runtime';
+import {twitchPermissions,twitchConsentDisclosure} from '../stream-machine/auth/permissions';
+import {TwitchError} from '../twitch/client';
+import type {TwitchService} from '../twitch/service';
+import {createHostedClipDownload} from '../clips/download';
+import {D1TitlePreviewStore} from './title-preview-store';
+
+type Setup={ready:boolean;missing:string[];redirectUri:string};
+export function hostedRuntime({ownerId,oauth,db,bucket,setup,fetcher=fetch}:{ownerId:string;oauth:TwitchService|(()=>TwitchService);db:D1Database|undefined;bucket?:R2Bucket;setup:Setup;fetcher?:typeof fetch}):TwitchToolRuntime {
+  const origin=new URL(setup.redirectUri).origin;
+  let generation:string|undefined;
+  const service=()=>typeof oauth==='function'?oauth():oauth;
+  const accounts:TwitchAccountProvider={
+    async withAccount(operation) {
+      try {return await service().withAccessToken(ownerId,access=>{generation=access.connectionGeneration;return operation(access);});}catch(error) {
+        if(error instanceof TwitchError)throw new TwitchFault(error.code==='not_connected'?'TWITCH_RECONNECT_REQUIRED':error.code==='refresh_in_progress'?'TWITCH_REFRESH_IN_PROGRESS':error.code==='connection_cancelled'?'TWITCH_RECONNECT_REQUIRED':error.code==='setup_incomplete'?'TWITCH_NOT_CONFIGURED':'TWITCH_UNAVAILABLE');
+        throw error;
+      }
+    },
+  };
+  let titles:TwitchTitleService|undefined;
+  const clips=new TwitchClipClient(fetcher);
+  return {
+    accounts,
+    get titles(){if(!db)throw new TwitchFault('TWITCH_NOT_CONFIGURED');return titles??=new TwitchTitleService(accounts,new TwitchChannelClient(fetcher),Date.now,new D1TitlePreviewStore(db,ownerId,()=>generation));},
+    async preflight(){return {mode:'live',provider:'hosted',executionLocation:'hosted',ready:setup.ready,missing:setup.missing,connectionUrl:`${origin}/`};},
+    async connect(_manageBroadcast,_manageClips,_openBrowser,replacePluginListener){
+      if(replacePluginListener)throw new TwitchFault('TWITCH_LOCAL_EXECUTION_REQUIRED');
+      if(!setup.ready)throw new TwitchFault('TWITCH_NOT_CONFIGURED');
+      const status=await service().status(ownerId);
+      return {mode:'live',provider:'hosted',executionLocation:'hosted',connectionUrl:`${origin}/`,authorizationUrl:`${origin}/`,browserRequested:false,disclosure:twitchConsentDisclosure,...twitchPermissions(status.scopes??[])};
+    },
+    approvalUrl(id){return `${origin}/twitch/approve?id=${encodeURIComponent(id)}`;},
+    async clip(id){return accounts.withAccount(async access=>({mode:'live',clip:await clips.read(access,id)}));},
+    async downloadClip(clipId){
+      if(!db||!bucket)throw new TwitchFault('TWITCH_NOT_CONFIGURED');
+      return createHostedClipDownload({ownerId,accounts,db,bucket,origin,client:clips})(clipId);
+    },
+  };
+}
diff --git a/lib/mcp/title-preview-store.ts b/lib/mcp/title-preview-store.ts
new file mode 100644
index 0000000..cf842f8
--- /dev/null
+++ b/lib/mcp/title-preview-store.ts
@@ -0,0 +1,55 @@
+import {z} from 'zod';
+import {TwitchFault} from '../stream-machine/auth/twitch';
+import type {TitlePreview,TitlePreviewStore} from '../stream-machine/adapters/twitch/title-preview-store';
+
+const rowSchema=z.object({
+  preview_id:z.string(),
+  before_json:z.string(),
+  title:z.string(),
+  expires_at:z.number(),
+  approved:z.number(),
+  consumed:z.number(),
+});
+const channelSchema=z.object({broadcasterId:z.string(),login:z.string(),displayName:z.string(),title:z.string(),categoryId:z.string(),categoryName:z.string()});
+
+export class D1TitlePreviewStore implements TitlePreviewStore {
+  constructor(private readonly db:D1Database,private readonly ownerId:string,private readonly generation?:()=>string|undefined) {}
+
+  async create(preview:TitlePreview,now:number) {
+    const result=await this.db.batch([
+      this.db.prepare('DELETE FROM twitch_title_previews WHERE owner_id=? AND expires_at<=?').bind(this.ownerId,now),
+      this.db.prepare('INSERT INTO twitch_title_previews (owner_id,preview_id,connection_generation,before_json,title,expires_at,approved,consumed) SELECT ?,?,connection_generation,?,?,?,0,0 FROM twitch_connections WHERE owner_id=? AND twitch_user_id=? AND (? IS NULL OR connection_generation=?) AND (SELECT COUNT(*) FROM twitch_title_previews WHERE owner_id=?)<100 RETURNING preview_id').bind(this.ownerId,preview.id,JSON.stringify(preview.before),preview.title,preview.expiresAt,this.ownerId,preview.before.broadcasterId,this.generation?.()??null,this.generation?.()??null,this.ownerId),
+    ]);
+    if(!result[1]?.results.length){
+      const current=await this.db.prepare('SELECT connection_generation FROM twitch_connections WHERE owner_id=? AND (? IS NULL OR connection_generation=?)').bind(this.ownerId,this.generation?.()??null,this.generation?.()??null).first();
+      throw new TwitchFault(current?'PREVIEW_LIMIT':'TWITCH_RECONNECT_REQUIRED');
+    }
+  }
+
+  async get(id:string):Promise<TitlePreview|undefined> {
+    const value=await this.db.prepare('SELECT preview_id,before_json,title,expires_at,approved,consumed FROM twitch_title_previews WHERE owner_id=? AND preview_id=? AND connection_generation=(SELECT connection_generation FROM twitch_connections WHERE owner_id=?) AND (? IS NULL OR connection_generation=?)').bind(this.ownerId,id,this.ownerId,this.generation?.()??null,this.generation?.()??null).first();
+    if(!value)return undefined;
+    const row=rowSchema.parse(value);
+    return {id:row.preview_id,before:channelSchema.parse(JSON.parse(row.before_json)),title:row.title,expiresAt:row.expires_at,approved:row.approved===1,consumed:row.consumed===1};
+  }
+
+  async approve(id:string,now:number) {
+    return !!await this.db.prepare('UPDATE twitch_title_previews SET approved=1 WHERE owner_id=? AND preview_id=? AND expires_at>? AND consumed=0 AND connection_generation=(SELECT connection_generation FROM twitch_connections WHERE owner_id=?) AND (? IS NULL OR connection_generation=?) RETURNING preview_id').bind(this.ownerId,id,now,this.ownerId,this.generation?.()??null,this.generation?.()??null).first();
+  }
+
+  async consume(id:string,now:number) {
+    return !!await this.db.prepare('UPDATE twitch_title_previews SET consumed=1 WHERE owner_id=? AND preview_id=? AND approved=1 AND consumed=0 AND expires_at>? AND connection_generation=(SELECT connection_generation FROM twitch_connections WHERE owner_id=?) AND (? IS NULL OR connection_generation=?) RETURNING preview_id').bind(this.ownerId,id,now,this.ownerId,this.generation?.()??null,this.generation?.()??null).first();
+  }
+
+  async clear() {
+    await this.db.prepare('DELETE FROM twitch_title_previews WHERE owner_id=?').bind(this.ownerId).run();
+  }
+
+  async acquire(lease:string,now:number) {
+    return !!await this.db.prepare('INSERT INTO twitch_title_execution (owner_id,lease_id,until_at) VALUES (?,?,?) ON CONFLICT(owner_id) DO UPDATE SET lease_id=excluded.lease_id,until_at=excluded.until_at WHERE twitch_title_execution.until_at<=? RETURNING owner_id').bind(this.ownerId,lease,now+60000,now).first();
+  }
+
+  async release(lease:string) {
+    await this.db.prepare('DELETE FROM twitch_title_execution WHERE owner_id=? AND lease_id=?').bind(this.ownerId,lease).run();
+  }
+}
diff --git a/lib/stream-machine/adapters/twitch/client.ts b/lib/stream-machine/adapters/twitch/client.ts
new file mode 100644
index 0000000..fbcc5d9
--- /dev/null
+++ b/lib/stream-machine/adapters/twitch/client.ts
@@ -0,0 +1,41 @@
+import { z } from "zod";
+import { TwitchFault, type TwitchAccess } from "../../auth/twitch";
+const channelSchema = z.object({ broadcaster_id: z.string(), broadcaster_login: z.string(), broadcaster_name: z.string(), title: z.string(), game_id: z.string(), game_name: z.string() });
+const imageSchema = z.union([z.literal(""), z.url({ protocol: /^https$/ })]).transform(value => value || null);
+const profileSchema = z.object({ id: z.string().min(1), login: z.string().min(1), display_name: z.string().min(1), description: z.string(), profile_image_url: imageSchema, offline_image_url: imageSchema });
+export type TwitchProfile = { broadcasterId: string; login: string; displayName: string; description: string; profilePictureUrl: string | null; offlinePlaceholderUrl: string | null };
+export type TwitchChannel = { broadcasterId: string; login: string; displayName: string; title: string; categoryId: string; categoryName: string };
+export class TwitchChannelClient {
+  constructor(private fetcher: typeof fetch = fetch) {}
+  private async request(access: TwitchAccess, resource: "channels" | "users", title?: string) {
+    let response: Response;
+    try {
+      response = await this.fetcher(`https://api.twitch.tv/helix/${resource}${resource === "channels" ? `?broadcaster_id=${encodeURIComponent(access.account.id)}` : ""}`, {
+        method: title === undefined ? "GET" : "PATCH", signal: AbortSignal.timeout(12000),
+        headers: { Authorization: `Bearer ${access.accessToken}`, "Client-Id": access.clientId, "Content-Type": "application/json" },
+        ...(title === undefined ? {} : { body: JSON.stringify({ title }) }),
+      });
+    } catch { throw new TwitchFault(title === undefined ? "TWITCH_UNAVAILABLE" : "WRITE_OUTCOME_UNKNOWN"); }
+    if (!response.ok) throw new TwitchFault(response.status === 401 ? "TWITCH_RECONNECT_REQUIRED" : response.status === 403 ? "TWITCH_SCOPE_REQUIRED" : response.status === 429 ? "TWITCH_RATE_LIMITED" : title !== undefined && response.status >= 500 ? "WRITE_OUTCOME_UNKNOWN" : "TWITCH_UNAVAILABLE");
+    return response;
+  }
+  async read(access: TwitchAccess): Promise<TwitchChannel> {
+    const response = await this.request(access, "channels");
+    let value: unknown; try { value = await response.json(); } catch { throw new TwitchFault("TWITCH_INVALID_RESPONSE"); }
+    const parsed = z.object({ data: z.array(channelSchema).length(1) }).safeParse(value);
+    if (!parsed.success) throw new TwitchFault("TWITCH_INVALID_RESPONSE");
+    const channel = parsed.data.data[0];
+    if (!channel || channel.broadcaster_id !== access.account.id) throw new TwitchFault("TWITCH_WRONG_ACCOUNT");
+    return { broadcasterId: channel.broadcaster_id, login: channel.broadcaster_login, displayName: channel.broadcaster_name, title: channel.title, categoryId: channel.game_id, categoryName: channel.game_name };
+  }
+  async readProfile(access: TwitchAccess): Promise<TwitchProfile> {
+    const response = await this.request(access, "users");
+    let value: unknown; try { value = await response.json(); } catch { throw new TwitchFault("TWITCH_INVALID_RESPONSE"); }
+    const parsed = z.object({ data: z.array(profileSchema).length(1) }).safeParse(value);
+    if (!parsed.success) throw new TwitchFault("TWITCH_INVALID_RESPONSE");
+    const profile = parsed.data.data[0];
+    if (!profile || profile.id !== access.account.id) throw new TwitchFault("TWITCH_WRONG_ACCOUNT");
+    return { broadcasterId: profile.id, login: profile.login, displayName: profile.display_name, description: profile.description, profilePictureUrl: profile.profile_image_url, offlinePlaceholderUrl: profile.offline_image_url };
+  }
+  async writeTitle(access: TwitchAccess, title: string) { await this.request(access, "channels", title); }
+}
diff --git a/lib/stream-machine/adapters/twitch/clips-client.ts b/lib/stream-machine/adapters/twitch/clips-client.ts
new file mode 100644
index 0000000..179bb49
--- /dev/null
+++ b/lib/stream-machine/adapters/twitch/clips-client.ts
@@ -0,0 +1,39 @@
+import { z } from "zod";
+import { TwitchFault, type TwitchAccess } from "../../auth/twitch";
+export const clipIdSchema = z.string().regex(/^[A-Za-z0-9_-]{1,256}$/);
+const clipSchema = z.object({ id: clipIdSchema, broadcaster_id: z.string().min(1), title: z.string(), url: z.url() });
+const downloadSchema = z.object({ clip_id: clipIdSchema, landscape_download_url: z.string().nullable(), portrait_download_url: z.string().nullable() });
+export class TwitchClipClient {
+  constructor(private fetcher: typeof fetch = fetch) {}
+  private async request(access: TwitchAccess, path: string, params: Record<string, string>): Promise<unknown> {
+    let response: Response;
+    try {
+      response = await this.fetcher(`https://api.twitch.tv/helix/${path}?${new URLSearchParams(params)}`, {
+        redirect: "error", signal: AbortSignal.timeout(12000),
+        headers: { Authorization: `Bearer ${access.accessToken}`, "Client-Id": access.clientId },
+      });
+    } catch { throw new TwitchFault("TWITCH_UNAVAILABLE"); }
+    if (!response.ok) throw new TwitchFault(response.status === 401 ? "TWITCH_RECONNECT_REQUIRED" : response.status === 403 ? "TWITCH_SCOPE_REQUIRED" : response.status === 429 ? "TWITCH_RATE_LIMITED" : "TWITCH_UNAVAILABLE");
+    try { return await response.json(); } catch { throw new TwitchFault("TWITCH_INVALID_RESPONSE"); }
+  }
+  async read(access: TwitchAccess, clipId: string) {
+    const parsed = z.object({ data: z.array(clipSchema).max(1) }).safeParse(await this.request(access, "clips", { id: clipId }));
+    if (!parsed.success) throw new TwitchFault("TWITCH_INVALID_RESPONSE");
+    const clip = parsed.data.data[0];
+    if (!clip) throw new TwitchFault("CLIP_NOT_FOUND");
+    if (clip.id !== clipId) throw new TwitchFault("TWITCH_INVALID_RESPONSE");
+    const source = new URL(clip.url);
+    if (source.protocol !== "https:" || !["clips.twitch.tv", "www.twitch.tv"].includes(source.hostname) || source.username || source.password || source.port) throw new TwitchFault("TWITCH_INVALID_RESPONSE");
+    return { id: clip.id, broadcasterId: clip.broadcaster_id, title: clip.title, sourceUrl: clip.url };
+  }
+  async download(access: TwitchAccess, clipId: string) {
+    const parsed = z.object({ data: z.array(downloadSchema).max(1) }).safeParse(await this.request(access, "clips/downloads", { broadcaster_id: access.account.id, editor_id: access.account.id, clip_id: clipId }));
+    if (!parsed.success) throw new TwitchFault("TWITCH_INVALID_RESPONSE");
+    const clip = parsed.data.data[0];
+    if (!clip) throw new TwitchFault("CLIP_FORMAT_UNAVAILABLE");
+    if (clip.clip_id !== clipId) throw new TwitchFault("TWITCH_INVALID_RESPONSE");
+    if (clip.landscape_download_url) return { format: "landscape", url: clip.landscape_download_url };
+    if (clip.portrait_download_url) return { format: "portrait", url: clip.portrait_download_url };
+    throw new TwitchFault("CLIP_FORMAT_UNAVAILABLE");
+  }
+}
diff --git a/lib/stream-machine/adapters/twitch/service.ts b/lib/stream-machine/adapters/twitch/service.ts
new file mode 100644
index 0000000..ee9e9ff
--- /dev/null
+++ b/lib/stream-machine/adapters/twitch/service.ts
@@ -0,0 +1,60 @@
+import { TwitchFault, type TwitchAccountProvider } from "../../auth/twitch";
+import { TwitchChannelClient } from "./client";
+import { BROADCAST_SCOPE, twitchPermissions } from "../../auth/permissions";
+import { MemoryTitlePreviewStore, type TitlePreviewStore } from "./title-preview-store";
+export const TITLE_SCOPE = BROADCAST_SCOPE;
+export class TwitchTitleService {
+  private executing = false;
+  constructor(readonly accounts: TwitchAccountProvider, private client = new TwitchChannelClient(), private now = Date.now, private previews: TitlePreviewStore = new MemoryTitlePreviewStore()) {}
+  async status() { return this.accounts.withAccount(async ({ account }) => ({ mode: "live", account: { ...account, scopes: [...account.scopes] }, ...twitchPermissions(account.scopes) })); }
+  async channel() { return this.accounts.withAccount(async access => ({ mode: "live", channel: await this.client.read(access) })); }
+  async profile() { return this.accounts.withAccount(async access => ({ mode: "live", source: "https://api.twitch.tv/helix/users", profile: await this.client.readProfile(access) })); }
+  async preview(title: string) {
+    if (!title.trim() || [...title].length > 140) throw new TwitchFault("INVALID_TITLE");
+    return this.accounts.withAccount(async access => {
+      const before = await this.client.read(access);
+      if (title === before.title) throw new TwitchFault("NO_TITLE_CHANGE");
+      const p = { id: crypto.randomUUID(), before, title, expiresAt: this.now() + 300000, approved: false, consumed: false };
+      await this.previews.create(p, this.now());
+      return { mode: "live", executable: access.account.scopes.includes(TITLE_SCOPE), previewId: p.id, account: access.account.id, before, after: { title }, expiresAt: p.expiresAt, requiredScope: TITLE_SCOPE };
+    });
+  }
+  async approvalDetails(id: string) { const p = await this.pending(id); return { previewId: p.id, account: p.before.login, before: p.before.title, after: p.title, expiresAt: p.expiresAt }; }
+  async approve(id: string) {
+    await this.pending(id);
+    if (!await this.previews.approve(id, this.now())) { await this.pending(id); throw new TwitchFault("PREVIEW_CONSUMED"); }
+  }
+  async clear() { await this.previews.clear(); }
+  private async pending(id: string) {
+    const p = await this.previews.get(id);
+    if (!p) throw new TwitchFault("PREVIEW_NOT_FOUND");
+    if (p.consumed) throw new TwitchFault("PREVIEW_CONSUMED");
+    if (p.expiresAt <= this.now()) throw new TwitchFault("PREVIEW_EXPIRED");
+    return p;
+  }
+  async apply(id: string) {
+    if (this.executing) throw new TwitchFault("TWITCH_EXECUTION_BUSY");
+    const p = await this.pending(id);
+    if (!p.approved) throw new TwitchFault("BROWSER_APPROVAL_REQUIRED");
+    this.executing = true;
+    const lease = crypto.randomUUID();
+    let acquired = false;
+    try {
+      return await this.accounts.withAccount(async access => {
+        if (access.account.id !== p.before.broadcasterId) throw new TwitchFault("TWITCH_WRONG_ACCOUNT");
+        if (!access.account.scopes.includes(TITLE_SCOPE)) throw new TwitchFault("TWITCH_SCOPE_REQUIRED");
+        acquired = await this.previews.acquire(lease, this.now());
+        if (!acquired) throw new TwitchFault("TWITCH_EXECUTION_BUSY");
+        const current = await this.client.read(access);
+        if (current.title !== p.before.title || current.categoryId !== p.before.categoryId) throw new TwitchFault("PREVIEW_STALE");
+        await this.pending(id);
+        if (!await this.previews.consume(id, this.now())) { await this.pending(id); throw new TwitchFault("PREVIEW_CONSUMED"); }
+        await this.client.writeTitle(access, p.title);
+        try {
+          const channel = await this.client.read(access);
+          return { mode: "live", status: channel.title === p.title ? "verified" : "applied_unverified", previewId: id, channel };
+        } catch { return { mode: "live", status: "applied_unverified", previewId: id }; }
+      });
+    } finally { this.executing = false; if (acquired) await this.previews.release(lease); }
+  }
+}
diff --git a/lib/stream-machine/adapters/twitch/title-preview-store.ts b/lib/stream-machine/adapters/twitch/title-preview-store.ts
new file mode 100644
index 0000000..43f08c5
--- /dev/null
+++ b/lib/stream-machine/adapters/twitch/title-preview-store.ts
@@ -0,0 +1,47 @@
+import { TwitchFault } from "../../auth/twitch";
+import type { TwitchChannel } from "./client";
+
+export type TitlePreview = { id: string; before: TwitchChannel; title: string; expiresAt: number; approved: boolean; consumed: boolean };
+
+export interface TitlePreviewStore {
+  create(preview: TitlePreview, now: number): Promise<void>;
+  get(id: string): Promise<TitlePreview | undefined>;
+  approve(id: string, now: number): Promise<boolean>;
+  consume(id: string, now: number): Promise<boolean>;
+  clear(): Promise<void>;
+  acquire(lease: string, now: number): Promise<boolean>;
+  release(lease: string): Promise<void>;
+}
+
+export class MemoryTitlePreviewStore implements TitlePreviewStore {
+  private previews = new Map<string, TitlePreview>();
+  private execution: { lease: string; until: number } | undefined;
+  async create(preview: TitlePreview, now: number) {
+    for (const [id, entry] of this.previews) if (entry.expiresAt <= now) this.previews.delete(id);
+    if (this.previews.size >= 100) throw new TwitchFault("PREVIEW_LIMIT");
+    this.previews.set(preview.id, structuredClone(preview));
+  }
+  async get(id: string) {
+    const preview = this.previews.get(id);
+    return preview && structuredClone(preview);
+  }
+  async approve(id: string, now: number) {
+    const preview = this.previews.get(id);
+    if (!preview || preview.consumed || preview.expiresAt <= now) return false;
+    preview.approved = true;
+    return true;
+  }
+  async consume(id: string, now: number) {
+    const preview = this.previews.get(id);
+    if (!preview || !preview.approved || preview.consumed || preview.expiresAt <= now) return false;
+    preview.consumed = true;
+    return true;
+  }
+  async clear() { this.previews.clear(); }
+  async acquire(lease: string, now: number) {
+    if (this.execution && this.execution.until > now) return false;
+    this.execution = { lease, until: now + 60000 };
+    return true;
+  }
+  async release(lease: string) { if (this.execution?.lease === lease) this.execution = undefined; }
+}
diff --git a/lib/stream-machine/adapters/twitch/tool-register.ts b/lib/stream-machine/adapters/twitch/tool-register.ts
new file mode 100644
index 0000000..62c6785
--- /dev/null
+++ b/lib/stream-machine/adapters/twitch/tool-register.ts
@@ -0,0 +1,63 @@
+import { z } from "zod";
+import { TwitchFault } from "../../auth/twitch";
+import { clipIdSchema } from "./clips-client";
+import type { TwitchToolRuntime } from "./tool-runtime";
+
+type TwitchToolResult = {
+  content: { type: "text"; text: string }[];
+  structuredContent: { twitch: object } | { error: { code: string } };
+  isError?: boolean;
+};
+
+const definitions = {
+  stream_machine_twitch_preflight: { schema: z.object({}).strict(), description: "Check the selected Twitch provider configuration before onboarding. Does not authorize Twitch or change the channel." },
+  stream_machine_twitch_status: { schema: z.object({}).strict(), description: "Validate the selected real Twitch connection and show account and scopes. No mock fallback." },
+  stream_machine_twitch_connect: { schema: z.object({ manageBroadcast: z.boolean().default(false), manageClips: z.boolean().default(false), openBrowser: z.boolean().default(false), replacePluginListener: z.boolean().default(false) }).strict(), description: "Get the selected provider's Twitch connection URL. Review the returned permission disclosure before consent. Hosted requests return a Site URL. Local openBrowser and replacePluginListener require explicit user authorization; replacement stops only a verified Stream Machine plugin process. Legacy permission flags cannot reduce required permissions." },
+  stream_machine_twitch_channel: { schema: z.object({}).strict(), description: "Read the connected broadcaster's real current title and category." },
+  stream_machine_twitch_profile: { schema: z.object({}).strict(), description: "Read the connected account description, profile photo URL, and offline video-player image URL. The offline image is not a profile banner or header. No write." },
+  stream_machine_twitch_preview_title: { schema: z.object({ title: z.string().min(1).max(280) }).strict(), description: "Preview the exact connected-account title change, without writing. Open the returned approval URL to approve in a browser." },
+  stream_machine_twitch_apply_title: { schema: z.object({ previewId: z.string().uuid() }).strict(), description: "Apply the browser-approved exact preview to the connected broadcaster. Recheck scope and current title, then read back. Live mutation." },
+  stream_machine_twitch_clip: { schema: z.object({ clipId: clipIdSchema }).strict(), description: "Read real Twitch clip metadata by ID. No download or mock fallback." },
+  stream_machine_twitch_download_clip: { schema: z.object({ clipId: clipIdSchema }).strict(), description: "Download one connected broadcaster-owned Twitch clip through the selected provider. Requires explicit clip permission. No mock fallback." },
+};
+
+export function createTwitchToolDefinitions(getRuntime: () => TwitchToolRuntime) {
+  return Object.entries(definitions).map(([name, definition]) => ({
+    name, ...definition,
+    annotations: { readOnlyHint: !["stream_machine_twitch_apply_title", "stream_machine_twitch_connect", "stream_machine_twitch_download_clip"].includes(name), destructiveHint: false, openWorldHint: true },
+    async execute(input: unknown): Promise<TwitchToolResult> {
+      try {
+        const args = definition.schema.parse(input);
+        const runtime = getRuntime();
+        let result: object;
+        if (name === "stream_machine_twitch_preflight") result = await runtime.preflight();
+        else if (name === "stream_machine_twitch_connect" && "manageBroadcast" in args) result = await runtime.connect(args.manageBroadcast, args.manageClips, args.openBrowser, args.replacePluginListener);
+        else if (name === "stream_machine_twitch_preview_title" && "title" in args) {
+          const preview = await runtime.titles.preview(args.title);
+          result = { ...preview, approvalUrl: runtime.approvalUrl(preview.previewId) };
+        } else if (name === "stream_machine_twitch_apply_title" && "previewId" in args) result = await runtime.titles.apply(args.previewId);
+        else if (name === "stream_machine_twitch_channel") result = await runtime.titles.channel();
+        else if (name === "stream_machine_twitch_profile") result = await runtime.titles.profile();
+        else if (name === "stream_machine_twitch_clip" && "clipId" in args) result = await runtime.clip(args.clipId);
+        else if (name === "stream_machine_twitch_download_clip" && "clipId" in args) result = await runtime.downloadClip(args.clipId);
+        else result = await runtime.titles.status();
+        return { content: [{ type: "text", text: JSON.stringify(result) }], structuredContent: { twitch: result } };
+      } catch (error) {
+        const unavailable = name.endsWith("_clip") ? "CLIP_UNAVAILABLE" : "TWITCH_UNAVAILABLE";
+        const code = error instanceof TwitchFault ? error.code : error instanceof z.ZodError ? "INVALID_INPUT" : unavailable;
+        return { isError: true, content: [{ type: "text", text: code }], structuredContent: { error: { code } } };
+      }
+    },
+  }));
+}
+
+type TwitchToolDefinition = ReturnType<typeof createTwitchToolDefinitions>[number];
+type TwitchToolRegistrar = {
+  registerTool(name: string, config: { description: string; inputSchema: TwitchToolDefinition["schema"]; annotations: TwitchToolDefinition["annotations"] }, execute: TwitchToolDefinition["execute"]): unknown;
+};
+
+export function registerTwitchToolSet(server: TwitchToolRegistrar, getRuntime: () => TwitchToolRuntime) {
+  for (const definition of createTwitchToolDefinitions(getRuntime)) {
+    server.registerTool(definition.name, { description: definition.description, inputSchema: definition.schema, annotations: definition.annotations }, definition.execute);
+  }
+}
