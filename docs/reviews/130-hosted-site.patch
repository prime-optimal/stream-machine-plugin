+++ b/app/api/twitch/channel/route.ts
@@ -0,0 +1,13 @@
+import {POST as mcpPost} from '@/app/mcp/route';
+import {sitesPrincipal} from '@/lib/mcp/handler';
+
+export async function POST(request:Request) {
+  if(!sitesPrincipal(request))return mcpPost(request);
+  if(new URL(request.url).search||await request.text())return Response.json({error:'invalid_parameters'},{status:400,headers:{'Cache-Control':'no-store'}});
+  const headers=new Headers(request.headers);
+  headers.set('Content-Type','application/json');
+  return mcpPost(new Request(new URL('/mcp',request.url),{
+    method:'POST',headers,signal:request.signal,
+    body:JSON.stringify({jsonrpc:'2.0',id:'channel',method:'tools/call',params:{name:'stream_machine_twitch_channel',arguments:{}}}),
+  }));
+}
