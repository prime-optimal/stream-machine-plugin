+import {describe,expect,test} from 'bun:test';
+import {createHash} from 'node:crypto';
+import {createHostedClipWriter} from '../../lib/clips/storage-writer.ts';
+const url='https://production.assets.clips.twitchcdn.net/clip.mp4?sig=fixture';
+function fixture(options={}) {
+  const calls=[];
+  const store={async write(input){const data=new Uint8Array(await new Response(input.body).arrayBuffer());const final=await input.completion;calls.push({...final,ownerId:input.ownerId,data});return {storage:'hosted',id:'artifact',url:'https://studio.example/api/user-data/files/artifact',...final,completedAt:'fixture'};}};
+  const writer=createHostedClipWriter({ownerId:'sites-A',store,createStream:()=>new TransformStream(),fetcher:async()=>new Response('clip',{headers:{'content-length':'4'}}),...options});
+  return {writer,calls};
+}
+describe('hosted clip transfer',()=>{
+  test('streams exact bytes and SHA256 into bound owner store',async()=>{
+    const {writer,calls}=fixture();const artifact=await writer.write(url);
+    expect(artifact.storage).toBe('hosted');expect(artifact).not.toHaveProperty('path');
+    expect(calls[0].ownerId).toBe('sites-A');expect(calls[0].bytes).toBe(4);
+    expect(calls[0].sha256).toBe(createHash('sha256').update('clip').digest('hex'));
+  });
+  test('rejects missing owner before fetching',()=>{
+    let fetched=false;expect(()=>fixture({ownerId:'',fetcher:async()=>{fetched=true;return new Response('clip');}})).toThrow('SIGN_IN_REQUIRED');expect(fetched).toBe(false);
+  });
+  test.each(['http://production.assets.clips.twitchcdn.net/x','https://evil.example/x','https://user@production.assets.clips.twitchcdn.net/x'])('rejects unsafe URL %s',async(value)=>{
+    let fetched=false;const {writer}=fixture({fetcher:async()=>{fetched=true;return new Response('clip');}});
+    await expect(writer.write(value)).rejects.toThrow('CLIP_DOWNLOAD_URL_REJECTED');expect(fetched).toBe(false);
+  });
+  test.each([null,'abc','0','513'])('rejects unknown, invalid or oversized declared length %s',async(length)=>{
+    const headers=length===null?{}:{'content-length':length};const {writer,calls}=fixture({maxBytes:512,fetcher:async()=>new Response('clip',{headers})});
+    await expect(writer.write(url)).rejects.toThrow();expect(calls).toHaveLength(0);
+  });
+  test.each(['3','5'])('rejects actual length mismatch %s',async(length)=>{
+    const {writer,calls}=fixture({fetcher:async()=>new Response('clip',{headers:{'content-length':length}})});
+    await expect(writer.write(url)).rejects.toThrow('CLIP_DOWNLOAD_INVALID_RESPONSE');expect(calls).toHaveLength(0);
+  });
+  test('does not send API credentials to CDN or follow redirects',async()=>{
+    let init;const {writer}=fixture({fetcher:async(_url,options)=>{init=options;return new Response('clip',{headers:{'content-length':'4'}});}});
+    await writer.write(url);expect(init.redirect).toBe('error');expect(init.headers).toBeUndefined();
+  });
+  test('rejects redirect and expired source',async()=>{
+    for(const status of [302,403]){const {writer}=fixture({fetcher:async()=>new Response(null,{status})});await expect(writer.write(url)).rejects.toThrow(status===302?'CLIP_DOWNLOAD_REDIRECT_REJECTED':'CLIP_DOWNLOAD_EXPIRED');}
+  });
+  test('times out stalled fetch and upload',async()=>{
+    const stalled=()=>new Promise(()=>{});
+    for(const options of [{fetcher:stalled},{store:{write:stalled}}]){
+      const {writer}=fixture({...options,timeoutMs:10});await expect(writer.write(url)).rejects.toThrow('CLIP_DOWNLOAD_TIMEOUT');
+    }
+  });
+});
diff --git a/tests/clips/worker-fixture.ts b/tests/clips/worker-fixture.ts
