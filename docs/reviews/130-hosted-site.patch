+++ b/tests/twitch/mcp-handler.test.mjs
@@ -0,0 +1,90 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {handleMcp} from '../../lib/mcp/handler.ts';
+import {hostedRuntime} from '../../lib/mcp/runtime.ts';
+import {TwitchService} from '../../lib/twitch/service.ts';
+import {D1TitlePreviewStore} from '../../lib/mcp/title-preview-store.ts';
+import {fixture} from './helpers.mjs';
+
+const origin='https://studio.example';
+function request(method,params={},owner='alice',extra={}) {
+ return new Request(`${origin}/mcp`,{method:'POST',headers:{'content-type':'application/json',...(owner?{'oai-authenticated-user-id':owner}:{}),...extra},body:JSON.stringify({jsonrpc:'2.0',id:1,method,params})});
+}
+function unused(){assert.fail('Runtime created before validation');}
+
+test('every MCP request requires a Sites principal before parsing or runtime access',async()=>{
+ const invalid=new Request(`${origin}/mcp`,{method:'POST',headers:{'content-type':'application/json'},body:'not json'});
+ assert.equal((await handleMcp(invalid,unused)).status,401);
+ for(const method of ['server/discover','tools/list','tools/call'])assert.equal((await handleMcp(request(method,{},null),unused)).status,401);
+ assert.equal((await handleMcp(request('tools/list',{},'alice,bob'),unused)).status,401);
+ assert.equal((await handleMcp(request('tools/list',{},'alice',{'origin':'https://foreign.example'}),unused)).status,403);
+});
+
+test('Sites discovers all existing Twitch schemas without provider access',async()=>{
+ const discovery=await (await handleMcp(request('server/discover'),unused)).json();
+ assert.deepEqual(discovery.result.supportedVersions,['2026-07-28','2025-11-25','2025-06-18','2025-03-26']);
+ const list=await (await handleMcp(request('tools/list'),unused)).json();
+ assert.equal(list.result.tools.length,9);
+ for(const tool of list.result.tools)assert.equal(tool.inputSchema.additionalProperties,false);
+});
+
+test('owner, account, token, and provider selectors cannot override the principal',async()=>{
+ const list=await (await handleMcp(request('tools/list'),unused)).json();
+ for(const tool of list.result.tools) {
+  const valid=tool.name.endsWith('preview_title')?{title:'After'}:tool.name.endsWith('apply_title')?{previewId:crypto.randomUUID()}:tool.name.includes('clip')?{clipId:'ExampleClip'}:{};
+  for(const key of ['ownerId','userId','accountId','accessToken','provider']) {
+   const result=await (await handleMcp(request('tools/call',{name:tool.name,arguments:{...valid,[key]:'bob'}}),unused)).json();
+   assert.equal(result.result.isError,true);
+   assert.equal(result.result.structuredContent.error.code,'INVALID_INPUT');
+  }
+ }
+ const selected=await (await handleMcp(request('tools/call',{name:'stream_machine_twitch_status',arguments:{},ownerId:'bob'}),unused)).json();
+ assert.equal(selected.error.code,-32602);
+ const notification=new Request(`${origin}/mcp`,{method:'POST',headers:{'content-type':'application/json','oai-authenticated-user-id':'alice'},body:JSON.stringify({jsonrpc:'2.0',method:'tools/call',params:{name:'stream_machine_twitch_status',arguments:{}}})});
+ assert.equal((await handleMcp(notification,unused)).status,400);
+});
+
+test('MCP calls use owner-bound encrypted access and return no credentials',async()=>{
+ const f=fixture(),oauth=new TwitchService(f.store,f.client);
+ const start=await oauth.begin('alice');await oauth.complete('alice',start.state,start.state,'code',null);
+ const setup={ready:true,missing:[],redirectUri:`${origin}/api/twitch/callback`};
+ let providerCalls=0;
+ const fetcher=async()=>{providerCalls++;return Response.json({data:[{broadcaster_id:'twitch-user',broadcaster_login:'creator',broadcaster_name:'Creator',title:'Before',game_id:'1',game_name:'Category'}]});};
+ const runtime=ownerId=>hostedRuntime({ownerId,oauth,db:f.d1,setup,fetcher});
+ const alice=await (await handleMcp(request('tools/call',{name:'stream_machine_twitch_channel',arguments:{}}),runtime)).json();
+ assert.equal(alice.result.structuredContent.twitch.channel.login,'creator');
+ const bob=await (await handleMcp(request('tools/call',{name:'stream_machine_twitch_channel',arguments:{}},'bob'),runtime)).json();
+ assert.equal(bob.result.structuredContent.error.code,'TWITCH_RECONNECT_REQUIRED');
+ assert.equal(providerCalls,1);
+ for(const sentinel of ['test-access','test-refresh','test-secret','token_ciphertext'])assert.equal(JSON.stringify(alice).includes(sentinel),false);
+ const preview=await (await handleMcp(request('tools/call',{name:'stream_machine_twitch_preview_title',arguments:{title:'After'}}),runtime)).json();
+ const detail=preview.result.structuredContent.twitch;
+ assert.ok(detail.approvalUrl.startsWith(`${origin}/twitch/approve?id=`));
+ const stolen=await (await handleMcp(request('tools/call',{name:'stream_machine_twitch_apply_title',arguments:{previewId:detail.previewId}},'bob'),runtime)).json();
+ assert.equal(stolen.result.structuredContent.error.code,'PREVIEW_NOT_FOUND');
+ const download=await (await handleMcp(request('tools/call',{name:'stream_machine_twitch_download_clip',arguments:{clipId:'ExampleClip'}}),runtime)).json();
+ assert.equal(download.result.structuredContent.error.code,'TWITCH_NOT_CONFIGURED');
+ assert.equal(providerCalls,2);
+ await new D1TitlePreviewStore(f.d1,'alice').approve(detail.previewId,Date.now());
+ await oauth.disconnect('alice');
+ assert.equal(await new D1TitlePreviewStore(f.d1,'alice').get(detail.previewId),undefined);
+ f.sql.close();
+});
+
+test('initialize negotiates supported SDK versions and keeps Sites discovery first',async()=>{
+ for(const version of ['2025-11-25','2025-06-18','2025-03-26','2026-07-28']) {
+  const result=await (await handleMcp(request('initialize',{protocolVersion:version,capabilities:{},clientInfo:{name:'test-client',version:'1.0.0'}}),unused)).json();
+  assert.equal(result.result.protocolVersion,version);
+ }
+ const unknown=await (await handleMcp(request('initialize',{protocolVersion:'1999-01-01',capabilities:{},clientInfo:{name:'test-client',version:'1.0.0'}}),unused)).json();
+ assert.equal(unknown.result.protocolVersion,'2026-07-28');
+ const discovery=await (await handleMcp(request('server/discover'),unused)).json();
+ assert.equal(discovery.result.supportedVersions[0],'2026-07-28');
+});
+
+test('MCP accepts application/json exactly and rejects prefixed lookalike media types',async()=>{
+ const rejected=await handleMcp(request('tools/list',{},'alice',{'content-type':'text/application/json'}),unused);
+ assert.equal(rejected.status,415);
+ const accepted=await handleMcp(request('tools/list',{},'alice',{'content-type':'application/json; charset=utf-8'}),unused);
+ assert.equal(accepted.status,200);
+});
diff --git a/tests/twitch/mcp-preview.test.mjs b/tests/twitch/mcp-preview.test.mjs
