+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {TwitchService} from '../../lib/twitch/service.ts';
+import {hostedRuntime} from '../../lib/mcp/runtime.ts';
+import {D1TitlePreviewStore} from '../../lib/mcp/title-preview-store.ts';
+import {fixture} from './helpers.mjs';
+
+const setup={ready:true,missing:[],redirectUri:'https://studio.example/api/twitch/callback'};
+async function connected() {const f=fixture();const oauth=new TwitchService(f.store,f.client);const start=await oauth.begin('alice');await oauth.complete('alice',start.state,start.state,'code',null);return {...f,oauth};}
+function channel(title='Before'){return {data:[{broadcaster_id:'twitch-user',broadcaster_login:'creator',broadcaster_name:'Creator',title,game_id:'1',game_name:'Category'}]};}
+
+test('two request replicas can consume an approved title preview only once',async()=>{
+ const f=await connected();let writes=0,title='Before';
+ const fetcher=async(_url,init)=>{if(init.method==='PATCH'){writes++;title=JSON.parse(init.body).title;return new Response(null,{status:204});}return Response.json(channel(title));};
+ const runtime=()=>hostedRuntime({ownerId:'alice',oauth:f.oauth,db:f.d1,setup,fetcher});
+ const p=await runtime().titles.preview('After');
+ await new D1TitlePreviewStore(f.d1,'alice').approve(p.previewId,Date.now());
+ const results=await Promise.allSettled([runtime().titles.apply(p.previewId),runtime().titles.apply(p.previewId)]);
+ assert.equal(results.filter(r=>r.status==='fulfilled').length,1);
+ assert.equal(writes,1);
+ await assert.rejects(runtime().titles.apply(p.previewId),{code:'PREVIEW_CONSUMED'});
+ assert.equal(writes,1);f.sql.close();
+});
+
+test('an unknown title write outcome consumes the preview without retry',async()=>{
+ const f=await connected();let writes=0;
+ const fetcher=async(_url,init)=>{if(init.method==='PATCH'){writes++;throw new Error('network outcome unknown');}return Response.json(channel());};
+ const runtime=()=>hostedRuntime({ownerId:'alice',oauth:f.oauth,db:f.d1,setup,fetcher});
+ const p=await runtime().titles.preview('After');await new D1TitlePreviewStore(f.d1,'alice').approve(p.previewId,Date.now());
+ await assert.rejects(runtime().titles.apply(p.previewId),{code:'WRITE_OUTCOME_UNKNOWN'});
+ await assert.rejects(runtime().titles.apply(p.previewId),{code:'PREVIEW_CONSUMED'});
+ assert.equal(writes,1);f.sql.close();
+});
+
+test('reauthorizing the same Twitch account invalidates old and in-flight previews',async()=>{
+ const f=await connected();let release;
+ const waiting=new Promise(resolve=>{release=resolve;});
+ let entered;
+ const started=new Promise(resolve=>{entered=resolve;});
+ const fast=()=>hostedRuntime({ownerId:'alice',oauth:f.oauth,db:f.d1,setup,fetcher:async()=>Response.json(channel())});
+ const before=await fast().titles.preview('First title');
+ const slow=hostedRuntime({ownerId:'alice',oauth:f.oauth,db:f.d1,setup,fetcher:async()=>{entered();await waiting;return Response.json(channel());}}).titles.preview('Late title');
+ await started;
+ const start=await f.oauth.begin('alice');await f.oauth.complete('alice',start.state,start.state,'code',null);
+ assert.equal(await new D1TitlePreviewStore(f.d1,'alice').get(before.previewId),undefined);
+ release();await assert.rejects(slow);
+ const count=f.sql.prepare('SELECT COUNT(*) AS n FROM twitch_title_previews WHERE owner_id=?').get('alice').n;
+ assert.equal(count,0);f.sql.close();
+});
+
+test('unconfigured hosted service reports preflight without constructing OAuth',async()=>{
+ const runtime=hostedRuntime({ownerId:'alice',oauth:()=>assert.fail('OAuth created'),db:undefined,setup:{...setup,ready:false,missing:['DB']}});
+ assert.equal((await runtime.preflight()).ready,false);
+ await assert.rejects(runtime.connect(false,false,false,false),{code:'TWITCH_NOT_CONFIGURED'});
+});
+
+for(const reset of ['reconnect','disconnect','remove','clear'])test(`${reset} preserves an in-flight title execution lease`,async()=>{
+ const f=await connected();let release,entered,title='Before',writes=0;
+ const waiting=new Promise(resolve=>{release=resolve;}),started=new Promise(resolve=>{entered=resolve;});
+ const fetcher=async(_url,init)=>{
+  if(init.method==='PATCH'){const next=JSON.parse(init.body).title;writes++;if(next==='First'){entered();await waiting;}title=next;return new Response(null,{status:204});}
+  return Response.json(channel(title));
+ };
+ const runtime=()=>hostedRuntime({ownerId:'alice',oauth:f.oauth,db:f.d1,setup,fetcher});
+ const first=await runtime().titles.preview('First');await new D1TitlePreviewStore(f.d1,'alice').approve(first.previewId,Date.now());
+ const inflight=runtime().titles.apply(first.previewId);await started;
+ try {
+  if(reset==='disconnect')await f.oauth.disconnect('alice');
+  if(reset==='remove')await f.store.remove('alice');
+  if(reset==='clear')await new D1TitlePreviewStore(f.d1,'alice').clear();
+  if(reset!=='clear'){const start=await f.oauth.begin('alice');await f.oauth.complete('alice',start.state,start.state,'code',null);}
+  const second=await runtime().titles.preview('Second');await new D1TitlePreviewStore(f.d1,'alice').approve(second.previewId,Date.now());
+  await assert.rejects(runtime().titles.apply(second.previewId),{code:'TWITCH_EXECUTION_BUSY'});
+  release();await inflight;
+  await assert.rejects(runtime().titles.apply(second.previewId),{code:'PREVIEW_STALE'});
+  assert.equal(writes,1);
+ }finally{release();await inflight;f.sql.close();}
+});
