+++ b/tests/clips/worker-fixture.ts
@@ -0,0 +1,13 @@
+import {UserDataStore} from '../../lib/user-data/store';
+import {createHostedClipWriter} from '../../lib/clips/storage-writer';
+type Env={DB:D1Database;BUCKET:R2Bucket};
+export default {async fetch(request:Request,env:Env) {
+  const ownerId=request.headers.get('fixture-user');
+  if(!ownerId)return new Response(null,{status:401});
+  const store=new UserDataStore({db:env.DB,bucket:env.BUCKET,origin:new URL(request.url).origin});
+  if(request.method==='POST'){
+    const writer=createHostedClipWriter({ownerId,store,fetcher:async()=>new Response('clip',{headers:{'content-length':'4'}})});
+    return Response.json(await writer.write('https://production.assets.clips.twitchcdn.net/fixture.mp4'));
+  }
+  return store.read({ownerId,id:new URL(request.url).pathname.split('/').pop()??''});
+}};
