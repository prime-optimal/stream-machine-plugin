diff --git a/tests/twitch/scope-parity.test.mjs b/tests/twitch/scope-parity.test.mjs
new file mode 100644
index 0000000..eefeb2e
--- /dev/null
+++ b/tests/twitch/scope-parity.test.mjs
@@ -0,0 +1,50 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {TwitchService} from '../../lib/twitch/service.ts';
+import {fixture} from './helpers.mjs';
+const baseline=['bits:read','channel:bot','channel:manage:broadcast','channel:manage:clips','channel:manage:redemptions','channel:read:redemptions','channel:read:subscriptions','clips:edit','moderator:read:followers','user:bot','user:read:chat','user:write:chat'];
+test('hosted authorization requests exact local baseline and sorted deduplicated union',async()=>{
+ const {store,client}=fixture(),service=new TwitchService(store,client);
+ const first=await service.begin('owner');
+ assert.deepEqual(new URL(first.url).searchParams.get('scope').split(' '),baseline);
+ client.scopes=[...baseline,'user:read:email'];
+ await service.complete('owner',first.state,first.state,'code',null);
+ const next=await service.begin('owner',['bits:read','channel:read:goals','channel:read:goals']);
+ assert.deepEqual(new URL(next.url).searchParams.get('scope').split(' '),[...baseline,'user:read:email','channel:read:goals'].sort());
+});
+test('incomplete and denied reauthorization preserve existing connection',async()=>{
+ const {store,client}=fixture(),service=new TwitchService(store,client);
+ client.scopes=[...baseline];
+ const first=await service.begin('owner');await service.complete('owner',first.state,first.state,'code',null);
+ const previous=await store.get('owner');
+ client.exchange=async()=>({accessToken:'rejected-access',refreshToken:'rejected-refresh',expiresIn:3600,scopes:[...baseline]});
+ const incomplete=await service.begin('owner',['user:read:email']);
+ await assert.rejects(service.complete('owner',incomplete.state,incomplete.state,'code',null),{code:'missing_permissions'});
+ assert.deepEqual(await store.get('owner'),previous);
+ assert.ok(client.revocations.includes('rejected-access'));
+ assert.ok(!client.revocations.includes('test-access'));
+ const denied=await service.begin('owner');
+ await assert.rejects(service.complete('owner',denied.state,denied.state,null,'access_denied'),{code:'denied'});
+ assert.deepEqual(await store.get('owner'),previous);
+});
+
+test('incomplete reauthorization never revokes an identical prior access token',async()=>{
+ const {store,client}=fixture(),service=new TwitchService(store,client);
+ client.scopes=[...baseline];const first=await service.begin('owner');
+ await service.complete('owner',first.state,first.state,'code',null);
+ const previous=await store.get('owner');
+ const second=await service.begin('owner',['user:read:email']);
+ await assert.rejects(service.complete('owner',second.state,second.state,'code',null),{code:'missing_permissions'});
+ assert.deepEqual(await store.get('owner'),previous);
+ assert.ok(!client.revocations.includes('test-access'));
+});
+
+test('existing zero-scope connection stays connected and requests new consent',async()=>{
+ const {store,client}=fixture(),service=new TwitchService(store,client);
+ client.scopes=[...baseline];const first=await service.begin('owner');
+ await service.complete('owner',first.state,first.state,'code',null);
+ client.scopes=[];
+ const status=await service.status('owner');
+ assert.equal(status.connected,true);assert.equal(status.reconnectRequired,true);
+ assert.deepEqual(status.scopes,[]);assert.ok(await store.get('owner'));
+});
