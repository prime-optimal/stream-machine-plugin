diff --git a/scripts/sync-twitch-permissions.ts b/scripts/sync-twitch-permissions.ts
new file mode 100644
index 0000000..88c0f59
--- /dev/null
+++ b/scripts/sync-twitch-permissions.ts
@@ -0,0 +1,21 @@
+import { readFile, writeFile } from 'node:fs/promises';
+import { resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+import { createHash } from 'node:crypto';
+
+const source=resolve(process.argv.slice(2).find(argument=>argument!=='--check')??'../../src/auth/permissions.ts');
+const canonical=await import(pathToFileURL(source).href);
+const sourceBytes=await readFile(source);
+const snapshot={
+  source:'stream-machine-plugin/src/auth/permissions.ts',
+  sourceSha256:createHash('sha256').update(sourceBytes).digest('hex'),
+  requiredScopes:canonical.requiredTwitchScopes,
+  implementedScopes:canonical.implementedTwitchScopes,
+  futurePermissions:canonical.futureTwitchPermissions,
+  consentSummary:canonical.twitchConsentSummary,
+};
+const target=new URL('../lib/twitch/permissions.generated.json',import.meta.url);
+const text=JSON.stringify(snapshot,null,2)+'\n';
+if(process.argv.includes('--check')) {
+  if(await readFile(target,'utf8')!==text)throw new Error('Hosted Twitch scope snapshot differs from canonical source. Run sync-twitch-permissions.ts.');
+} else await writeFile(target,text);
