diff --git a/lib/clips/gallery-http.ts b/lib/clips/gallery-http.ts
new file mode 100644
index 0000000..5b3c5b6
--- /dev/null
+++ b/lib/clips/gallery-http.ts
@@ -0,0 +1,69 @@
+import {z} from 'zod';
+import {validPrincipal} from '../twitch/http';
+
+const headers = {'Cache-Control': 'no-store', 'Referrer-Policy': 'no-referrer'};
+const toolInput = z.object({
+  name: z.enum([
+    'stream_machine_open', 'stream_machine_twitch_status', 'stream_machine_twitch_preflight',
+    'stream_machine_twitch_connect', 'stream_machine_twitch_profile', 'stream_machine_twitch_snapshot',
+    'stream_machine_clips_library', 'stream_machine_clips_archive', 'stream_machine_clips_zip',
+  ]),
+  arguments: z.record(z.string(), z.unknown()).default({}),
+}).strict();
+const rpcResult = z.object({result: z.record(z.string(), z.unknown())});
+const maximumBytes = 16384;
+
+async function boundedBody(request: Request): Promise<string | null> {
+  const reader = request.body?.getReader();
+  if (!reader) return '';
+  const decoder = new TextDecoder();
+  let bytes = 0;
+  let text = '';
+  try {
+    while (true) {
+      const next = await reader.read();
+      if (next.done) return text + decoder.decode();
+      bytes += next.value.byteLength;
+      if (bytes > maximumBytes) { await reader.cancel(); return null; }
+      text += decoder.decode(next.value, {stream: true});
+    }
+  } finally { reader.releaseLock(); }
+}
+
+export async function handleGalleryTool(request: Request, dispatch: (request: Request) => Promise<Response>): Promise<Response> {
+  const failure = (status: number, code: string) => Response.json({isError: true, structuredContent: {error: {code}}}, {status, headers});
+  const ownerId = validPrincipal(request.headers.get('oai-authenticated-user-id'));
+  if (!ownerId) return failure(401, 'SIGN_IN_REQUIRED');
+  if (request.method !== 'POST') return failure(405, 'METHOD_NOT_ALLOWED');
+  const url = new URL(request.url);
+  if (request.headers.get('origin') !== url.origin) return failure(403, 'INVALID_ORIGIN');
+  if (url.search) return failure(400, 'INVALID_INPUT');
+  if (request.headers.get('content-type')?.split(';')[0]?.trim().toLowerCase() !== 'application/json') return failure(415, 'JSON_REQUIRED');
+  let input: z.infer<typeof toolInput>;
+  try {
+    const body = await boundedBody(request);
+    if (body === null) return failure(413, 'REQUEST_TOO_LARGE');
+    input = toolInput.parse(JSON.parse(body));
+  } catch { return failure(400, 'INVALID_INPUT'); }
+  try {
+    const forwarded = new Request(new URL('/mcp', url), {
+      method: 'POST', signal: request.signal,
+      headers: {'Content-Type': 'application/json', Origin: url.origin, 'oai-authenticated-user-id': ownerId},
+      body: JSON.stringify({jsonrpc: '2.0', id: 'gallery', method: 'tools/call', params: input}),
+    });
+    const response = await dispatch(forwarded);
+    if (!response.ok) return failure(response.status === 401 ? 401 : 502, response.status === 401 ? 'SIGN_IN_REQUIRED' : 'TOOL_UNAVAILABLE');
+    const parsed = rpcResult.safeParse(await response.json());
+    if (!parsed.success) return failure(502, 'TOOL_UNAVAILABLE');
+    return Response.json(parsed.data.result, {headers});
+  } catch { return failure(502, 'TOOL_UNAVAILABLE'); }
+}
+
+export function galleryPage(request: Request, html: string): Response {
+  if (!validPrincipal(request.headers.get('oai-authenticated-user-id'))) {
+    return new Response(null, {status: 303, headers: {
+      ...headers, Location: new URL('/signin-with-chatgpt?return_to=%2Fclips', request.url).toString(),
+    }});
+  }
+  return new Response(html, {headers: {...headers, 'Content-Type': 'text/html; charset=utf-8'}});
+}
