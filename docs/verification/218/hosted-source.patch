+  const repeat = await json('/fixture/archive', {owner, input: {clipId: 'c4'}});
+  expect(repeat.calls).toEqual([]);
+  expect(repeat.result.skipped).toEqual([{clipId: 'c4', reason: 'already_stored', stored}]);
+});
+
+test('batch archive returns stored metadata for saved and skipped clips from the bound owner', async () => {
+  const owner = 'handoff-batch';
+  const existing = await seed(owner, 'c1', 'mine');
+  await seed('handoff-other', 'c1', 'theirs');
+  const run = await json('/fixture/archive', {owner, input: {maxClips: 2}});
+  const stored = new Map(await json('/fixture/join', {owner, ids: ['c1', 'c2', 'c3']}));
+  expect(run.calls).toEqual(['c2', 'c3']);
+  expect(run.result.skipped).toEqual([{clipId: 'c1', reason: 'already_stored', stored: stored.get('c1')}]);
+  expect(run.result.skipped[0].stored.fileId).toBe(existing.id);
+  for (const entry of run.result.saved) {
+    expect(entry.stored).toEqual(stored.get(entry.clipId));
+    expect(entry).toMatchObject({fileId: entry.stored.fileId, playbackUrl: entry.stored.playbackUrl, bytes: entry.stored.bytes});
+  }
+});
+
+test.each(['missing', 'failed'])('post-write %s confirmation is unknown without another download', async confirmation => {
+  for (const input of [{clipId: 'c5'}, {maxClips: 1}]) {
+    const owner = 'handoff-' + confirmation + (input.clipId ? '-single' : '-batch');
+    const run = await json('/fixture/archive', {owner, input, confirmation});
+    expect(run.calls).toEqual([input.clipId ?? 'c1']);
+    expect(run.result.saved).toEqual([]);
+    expect(run.result.failed).toEqual([{clipId: input.clipId ?? 'c1', code: 'CLIP_SAVE_UNCONFIRMED', outcome: 'unknown'}]);
+  }
