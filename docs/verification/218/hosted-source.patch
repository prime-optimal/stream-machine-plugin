diff --git a/tests/clips/gallery-http.test.mjs b/tests/clips/gallery-http.test.mjs
new file mode 100644
index 0000000..dbc592b
--- /dev/null
+++ b/tests/clips/gallery-http.test.mjs
@@ -0,0 +1,56 @@
+import {describe, expect, test} from 'bun:test';
+import {galleryPage, handleGalleryTool} from '../../lib/clips/gallery-http';
+
+const origin = 'https://stream-machine.example';
+function request(body = {name: 'stream_machine_clips_library', arguments: {}}, extra = {}) {
+  return new Request(origin + '/api/tool', {method: 'POST', headers: {
+    'Content-Type': 'application/json', Origin: origin, 'oai-authenticated-user-id': 'owner-a', ...extra,
+  }, body: JSON.stringify(body)});
+}
+
+describe('authenticated gallery HTTP bridge', () => {
+  test('unsigned owner cookies do not authorize gallery reads or writes', async () => {
+    const req = request(undefined, {'oai-authenticated-user-id': '', Cookie: '__Host-stream-machine-owner=owner-a'});
+    const result = await handleGalleryTool(req, () => { throw new Error('must not dispatch'); });
+    expect(result.status).toBe(401);
+  });
+  test('cross-origin and missing-origin writes never dispatch', async () => {
+    for (const value of ['https://attacker.example', '']) {
+      const result = await handleGalleryTool(request({name: 'stream_machine_clips_archive', arguments: {clipId: 'clip'}}, {Origin: value}), () => { throw new Error('must not dispatch'); });
+      expect(result.status).toBe(403);
+    }
+  });
+  test('non-gallery tools and caller-selected owners are rejected', async () => {
+    for (const body of [{name: 'stream_machine_twitch_apply_title', arguments: {}}, {name: 'stream_machine_clips_library', arguments: {}, ownerId: 'other'}]) {
+      const result = await handleGalleryTool(request(body), () => { throw new Error('must not dispatch'); });
+      expect(result.status).toBe(400);
+    }
+  });
+  test('forwards the trusted principal and unwraps the exact tool result', async () => {
+    const result = {structuredContent: {archive: {saved: [{clipId: 'clip', stored: {playbackUrl: origin + '/api/user-data/files/clip'}}], failed: [], skipped: []}}};
+    const response = await handleGalleryTool(request({name: 'stream_machine_clips_archive', arguments: {clipId: 'clip'}}), async forwarded => {
+      expect(forwarded.url).toBe(origin + '/mcp');
+      expect(forwarded.headers.get('oai-authenticated-user-id')).toBe('owner-a');
+      expect((await forwarded.json()).params).toEqual({name: 'stream_machine_clips_archive', arguments: {clipId: 'clip'}});
+      return Response.json({jsonrpc: '2.0', id: 'gallery', result});
+    });
+    expect(await response.json()).toEqual(result);
+    expect(response.headers.get('cache-control')).toBe('no-store');
+  });
+  test('bounds inputs and sanitizes dispatch failures', async () => {
+    const oversized = await handleGalleryTool(request({name: 'stream_machine_clips_library', arguments: {value: 'x'.repeat(20000)}}), () => { throw new Error('must not dispatch'); });
+    expect(oversized.status).toBe(413);
+    const failed = await handleGalleryTool(request(), async () => { throw new Error('private details'); });
+    expect(failed.status).toBe(502);
+    expect(await failed.text()).not.toContain('private details');
+  });
+  test('gallery page uses platform sign-in and ignores owner cookies', () => {
+    const anonymous = galleryPage(new Request(origin + '/clips', {headers: {Cookie: '__Host-stream-machine-owner=owner-a'}}), '<html>gallery</html>');
+    expect(anonymous.status).toBe(303);
+    expect(anonymous.headers.get('location')).toBe(origin + '/signin-with-chatgpt?return_to=%2Fclips');
+    const signedIn = galleryPage(new Request(origin + '/clips', {headers: {'oai-authenticated-user-id': 'owner-a'}}), '<html>gallery</html>');
+    expect(signedIn.status).toBe(200);
+    expect(signedIn.headers.get('content-type')).toBe('text/html; charset=utf-8');
+    expect(signedIn.headers.get('cache-control')).toBe('no-store');
+  });
+});
